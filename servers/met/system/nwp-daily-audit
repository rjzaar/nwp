#!/usr/bin/env bash
# nwp-daily-audit — composer audit + upstream tracking for NWP sites on met.
# Posts findings to ops/<verifier>-log GitLab issues only when state changes.
# Created: 2026-05-22 (Worker-E follow-up to P63).
#
# Config:
#   - List sites to audit in the SITES array.
#   - Token at ~/.config/met-audit.token (chmod 600). Posts to ops/<verifier>-log id=11.
#   - Baseline stored at ~/.cache/nwp-daily-audit/baseline-<site>.json.
#   - Log appended to ~/nwp/logs/daily-audit.log.
#
# Exit codes: 0 = ran cleanly (regardless of findings). Non-zero = config error.

set -u

SITES=(
  "nwc-dev:/home/<operator>/nwp/sites/nwc/dev:goalgorilla/open_social"
  # site-key : ddev-project-dir : upstream-tracking-package-name (or empty)
  # add more sites here as they get composer trees on met
)

TOKEN_FILE="$HOME/.config/met-audit.token"
PROJECT_ID=11   # ops/<verifier>-log
BASELINE_DIR="$HOME/.cache/nwp-daily-audit"
LOG_FILE="$HOME/nwp/logs/daily-audit.log"
HOSTNAME="$(hostname)"

mkdir -p "$BASELINE_DIR" "$(dirname "$LOG_FILE")"

log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG_FILE" >&2; }

if [ ! -r "$TOKEN_FILE" ]; then
  log "ERROR: token file $TOKEN_FILE missing or unreadable"
  exit 2
fi
TOKEN="$(cat "$TOKEN_FILE")"

post_issue() {
  local title="$1"
  local body="$2"
  curl -sS --fail -X POST -H "PRIVATE-TOKEN: $TOKEN" \
    "https://<gitlab-host>/api/v4/projects/$PROJECT_ID/issues" \
    --data-urlencode "title=$title" \
    --data-urlencode "description=$body" \
    -o /dev/null -w "%{http_code}\n" 2>>"$LOG_FILE"
}

# ---------- composer audit (current site) ----------

audit_site() {
  local key="$1" dir="$2"
  if [ ! -d "$dir/.ddev" ]; then
    log "WARN: $key — no .ddev/ at $dir; skipping"
    return
  fi
  cd "$dir" || return

  # Run composer audit + outdated via ddev. Don't blow up if either fails.
  local audit_json="$BASELINE_DIR/run-$key-audit.json"
  local outdated_json="$BASELINE_DIR/run-$key-outdated.json"

  # composer audit exits nonzero when it finds advisories — that's
  # not an error for us, we want the JSON regardless. Capture output
  # and only WARN if no JSON was produced at all.
  /usr/local/bin/ddev exec composer audit --no-dev --format=json --no-interaction > "$audit_json" 2>>"$LOG_FILE"
  if [ ! -s "$audit_json" ]; then
    log "WARN: $key — composer audit produced no output"
  fi
  /usr/local/bin/ddev exec composer outdated --direct --format=json --no-interaction > "$outdated_json" 2>>"$LOG_FILE"
  if [ ! -s "$outdated_json" ]; then
    log "WARN: $key — composer outdated produced no output"
  fi

  echo "$audit_json $outdated_json"
}

# ---------- upstream tracking (Open Social main) ----------

upstream_diff() {
  local site_key="$1" dir="$2" upstream_pkg="$3"
  [ -z "$upstream_pkg" ] && return

  # Fetch upstream composer.json from goalgorilla/open_social main.
  local upstream_url="https://raw.githubusercontent.com/$upstream_pkg/main/composer.json"
  local upstream_json="$BASELINE_DIR/run-$site_key-upstream.json"
  if ! curl -sS --fail "$upstream_url" -o "$upstream_json" 2>>"$LOG_FILE"; then
    log "WARN: $site_key — failed to fetch $upstream_url"
    return
  fi

  # Compare drupal/* + key packages: ours vs upstream constraints.
  local our_json="$dir/composer.json"
  local profile_json="$dir/html/profiles/custom/nwc/composer.json"

  python3 - <<EOF
import json, sys, os

def load(p):
    try:
        return json.load(open(p))
    except Exception as e:
        return {}

upstream = load("$upstream_json").get("require", {})
ours_project = load("$our_json").get("require", {})
ours_profile = load("$profile_json").get("require", {})
ours = {**ours_project, **ours_profile}  # profile constraints win where they overlap

# Only care about packages BOTH sides constrain.
diffs = []
for k, up_v in sorted(upstream.items()):
    if not k.startswith("drupal/") and k != "webonyx/graphql-php":
        continue
    our_v = ours.get(k)
    if our_v and our_v != up_v:
        diffs.append((k, our_v, up_v))

if diffs:
    print("UPSTREAM_DELTA")
    for k, ov, uv in diffs:
        print(f"  {k}: ours={ov}  upstream={uv}")
else:
    print("NO_UPSTREAM_DELTA")
EOF
}

# ---------- diff against baseline ----------

# Produce a stable fingerprint of "interesting things to alert on":
# - audit advisories (id + package)
# - outdated direct deps (package + installed → latest)
# - upstream constraint drift
#
# Fingerprint stored at $BASELINE_DIR/baseline-<site>.txt.
# If today's fingerprint differs from baseline, post an issue and update baseline.

fingerprint() {
  local audit_json="$1" outdated_json="$2" upstream_out="$3"
  {
    if [ -s "$audit_json" ]; then
      python3 - "$audit_json" <<'PYEOF'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    # composer audit JSON shape varies by version. Recent: advisories
    # can be a list OR a dict keyed by package. Handle both.
    advs = d.get("advisories") or []
    if isinstance(advs, dict):
        for pkg, adv_list in sorted(advs.items()):
            for adv in adv_list:
                aid = adv.get("advisoryId") or adv.get("id") or "?"
                print("ADV " + pkg + " " + aid)
    elif isinstance(advs, list):
        for adv in advs:
            pkg = adv.get("packageName") or adv.get("package") or "?"
            aid = adv.get("advisoryId") or adv.get("id") or "?"
            print("ADV " + pkg + " " + aid)
    abandoned = d.get("abandoned") or {}
    if isinstance(abandoned, dict):
        for pkg in sorted(abandoned.keys()):
            print("ABANDONED " + pkg)
    elif isinstance(abandoned, list):
        for entry in abandoned:
            pkg = entry.get("packageName") or entry.get("package") or "?"
            print("ABANDONED " + pkg)
except Exception as e:
    print("ADV_PARSE_ERROR " + repr(e))
PYEOF
    fi
    if [ -s "$outdated_json" ]; then
      python3 - "$outdated_json" <<'PYEOF'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    for pkg in d.get("installed", []):
        name = pkg.get("name")
        cur = pkg.get("version")
        latest = pkg.get("latest")
        if cur != latest:
            print("OUTDATED " + str(name) + " " + str(cur) + " -> " + str(latest))
except Exception as e:
    print("OUT_PARSE_ERROR " + repr(e))
PYEOF
    fi
    echo "$upstream_out" | sed -n '/UPSTREAM_DELTA/,/^$/p' | grep -E "^\s+" | sed 's/^\s*/UPSTREAM /'
  } | sort
}

# ---------- main loop ----------

CHANGES=0
SUMMARY=""

for entry in "${SITES[@]}"; do
  IFS=':' read -r site_key dir upstream_pkg <<< "$entry"
  log "START $site_key (dir=$dir, upstream=$upstream_pkg)"

  read audit_json outdated_json <<< "$(audit_site "$site_key" "$dir")"
  upstream_out="$(upstream_diff "$site_key" "$dir" "$upstream_pkg")"

  current_fp_file="$BASELINE_DIR/current-$site_key.txt"
  baseline_fp_file="$BASELINE_DIR/baseline-$site_key.txt"
  fingerprint "$audit_json" "$outdated_json" "$upstream_out" > "$current_fp_file"

  if [ ! -f "$baseline_fp_file" ]; then
    log "$site_key: no baseline yet — creating one (silent run; not posting)"
    cp "$current_fp_file" "$baseline_fp_file"
    continue
  fi

  if ! diff -q "$baseline_fp_file" "$current_fp_file" > /dev/null; then
    log "$site_key: STATE CHANGE detected"
    CHANGES=$((CHANGES + 1))
    delta="$(diff -u "$baseline_fp_file" "$current_fp_file" | head -80)"

    SUMMARY+="### $site_key

\`\`\`diff
$delta
\`\`\`

"
    cp "$current_fp_file" "$baseline_fp_file"
  else
    log "$site_key: no change"
  fi
done

if [ "$CHANGES" -gt 0 ]; then
  log "Posting summary issue ($CHANGES site(s) changed)"
  TITLE="daily-audit: $CHANGES site(s) changed on $(date -u +%Y-%m-%d)"
  BODY="host: $HOSTNAME
time: $(date -u +%Y-%m-%dT%H:%M:%SZ)
producer: nwp-daily-audit (see ~/bin/nwp-daily-audit on met)
sites scanned: ${#SITES[@]}

This issue was opened because the audit/outdated/upstream-tracking
fingerprint for one or more sites changed since the last run. Each
section below is the unified-diff between yesterday's baseline and
today's fingerprint.

Lines starting with:
- \`ADV <package> <advisory-id>\` — composer audit finding
- \`ABANDONED <package>\` — composer abandoned-package warning
- \`OUTDATED <pkg> <cur> -> <latest>\` — composer outdated (direct deps)
- \`UPSTREAM <pkg>: ours=X upstream=Y\` — Open Social main differs from ours

A line with \`-\` removed (good — advisory fixed or dep caught up).
A line with \`+\` added (review needed — new advisory or new drift).

$SUMMARY

Triage: see docs/security/dependency-refresh-cadence.md."
    post_issue "$TITLE" "$BODY"
fi

log "DONE (changes=$CHANGES)"
