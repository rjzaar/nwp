#!/bin/bash
################################################################################
# /usr/local/bin/nwd-demo-reset-restricted — forced-command demo reset (ops#133)
#
# Installed on the git.nwpcode.org box as the SSH forced command for the
# dedicated `nwd-demo-reset@met` key:
#
#   command="/usr/local/bin/nwd-demo-reset-restricted",no-agent-forwarding,
#   no-port-forwarding,no-pty,no-user-rc,no-X11-forwarding ssh-ed25519 AAAA…
#
# WHY THIS EXISTS
#   `pl demo reset nwd --tier=live` orchestrates the nightly demo wipe over ssh
#   as `gitlab@`, and `gitlab@` on this box has NOPASSWD sudo — i.e. root on the
#   host that runs GitLab plus five live sites. Handing met a plain `gitlab@`
#   key would hand met root. Standing rule: never. Instead met gets a key that
#   can invoke exactly ONE program — this one — which performs the nwd demo
#   reset locally and nothing else.
#
# GUARANTEES (each enforced below, marked [Gn])
#   [G1] The client's command line is NEVER executed. $SSH_ORIGINAL_COMMAND is
#        logged verbatim and then matched against a fixed literal allowlist of
#        action words. Anything outside the allowlist is refused (exit 2). No
#        eval, no `sh -c`, no expansion of client data into any command.
#   [G2] The target is hard-wired to nwd. SITE/paths are constants; there is no
#        way to name another site. Before anything destructive the script also
#        re-checks that the live site reports nwc_demo_access demo_mode = true,
#        so even a mis-pointed SITE_ROOT cannot wipe a non-demo site.
#   [G3] Fail-closed on the golden image: manifest must name nwd and BOTH
#        artifacts must pass sha256 before a single byte is dropped.
#   [G4] Idle guard: a session newer than IDLE_WINDOW (or a failed/garbled
#        sessions query) counts as ACTIVE and exits 3 (retryable), never wipes.
#   [G5] Idempotent: one successful reset per Melbourne day (stamp file), plus a
#        hard minimum interval between resets — repeat invocations are cheap
#        no-ops, so met's cron can simply retry every 30 min.
#   [G6] Single-flight: flock, so overlapping invocations cannot interleave.
#   [G7] Every invocation (accepted or refused) appends one line to LOG_FILE.
#   [G8] Non-zero exit on failure; 3 = "active, retry"; 0 = reset done/no-op.
#   [G10] PENDING-UPDATE DETECTION (ops#226). After the restore the site is
#        asked whether it still owes a hook_update_N. A golden captured while
#        an update was pending re-pends it every single night — the restore
#        returns the pre-update schema and this script never runs updatedb —
#        so the condition is permanent and invisible. `pl demo golden` now
#        REFUSES such a capture, but goldens taken before that guard existed
#        are still out there, so the reset says so instead of reporting
#        reset-ok: pending updates (or an unreadable update state) degrade the
#        run exactly like a failed smoke check.
#   [G9] FATE MANIFEST (ops#47 impact contract, ops#143). Nothing destructive
#        runs until the manifest below has been printed AND logged, naming every
#        component and its fate with sizes read live off this box. This is
#        ENFORCED, not attempted: if the manifest cannot be rendered, or cannot
#        be persisted to LOG_FILE, a real reset ABORTS (exit 1) and destroys
#        nothing — because a reset with no surviving record of what it destroyed
#        is exactly the thing this guarantee exists to prevent. Degradation is
#        not failure: any figure that cannot be read prints "?" and the manifest
#        still stands, so only a total rendering/logging failure aborts.
#        `dry-run` prints exactly the same manifest and stops — so a dry run is
#        a truthful preview, not a different code path — and a dry run whose
#        manifest fails still exits 0, since nothing destructive follows it and
#        failing closed there would only take away an operator's ability to
#        look. There is no prompt here (the caller is met's cron over a forced
#        command, never a human at a TTY), so the manifest is the whole of the
#        contract: `-y` skips the PROMPT, never the REPORT, and here there is
#        only report.
#
# impact-contract: inline
#   This script is DEPLOYED TO A BOX WITH NO REPO CHECKOUT, so it cannot source
#   lib/impact.sh. It therefore renders the manifest itself; the pragma above is
#   what tells tests/unit/test-impact-contract.bats to expect an inline
#   `FATE MANIFEST` block rather than a source of the lib. The pragma ALONE does
#   not satisfy the gate — the manifest has to actually be there.
#
# NOT GUARANTEED (honest gaps — see docs/guides/demo-nightly-on-met.md §Gaps)
#   * The script runs AS `gitlab`, which has NOPASSWD sudo, and it uses sudo for
#     the www-data drush calls and the files restore. The containment is that
#     met can only *invoke* this script, not choose what it does — not that the
#     script is itself unprivileged. A dedicated unix account + a narrow
#     sudoers rule would remove that residue; recorded as follow-up.
#   * [G9]'s abort adds a way for the nightly to become a no-op: if LOG_FILE
#     stops being writable, every run refuses. That is the intended direction
#     (no record → no destruction), and it is visible: the refusal still prints
#     to stdout/stderr and exits 1, which met's cron captures in
#     ~/logs/demo-nightly-nwd.log, and the 30-min retry window means an operator
#     sees seven identical failures rather than one. It is NOT self-healing —
#     `status` (which never aborts) is the way to look.
#
# THE THREE NON-RESET LEGS (ops#315 + ops#219 — the box completes its own loop)
#   feedback-sync   push pending tester Feedback entities to GitLab through the
#                   module's OWN drush command, before the reset destroys them.
#                   The ops#140 minimisation interlock is preserved FAIL-CLOSED
#                   on this side of the wire: unless the deployed nwc_feedback
#                   provably carries buildIssueDescription, nothing leaves.
#   feedback-status the RETURN leg (ops#219 Phase A): the module's own
#                   nwc-feedback:sync-status pulls each linked GitLab issue's
#                   state back into the site — a CLOSED issue advances the
#                   signal fixed → poster_invited and emails the reporter the
#                   "please check this" invitation. Without it /my/feedback
#                   says "Sent to the team" for ever. Fired HOURLY from met
#                   over the same restricted key (pl demo schedule
#                   <site> --feedback-status --via-key).
#   harvest-post    post the spooled pre-wipe error digests to nwp/ops issues,
#                   from the box's own spool, then move them to posted/ so the
#                   `harvest` drain and this word never double-report.
#   Both authenticate with ONE walled api token read from TOKEN_FILE — a
#   root-owned 0600 file this wrapper NEVER creates, prints or logs
#   (provisioning is an operator step; see the registry entry
#   demo_box_feedback_token and install-box.sh's report). A missing token is
#   exit 2 CANNOT VERIFY — a leg that could not run and says so — never a
#   silent skip. This is the pattern the box already lives: local_feedback's
#   own gitlab_token posts issues at submit time today, so a walled
#   issue-write token on this host is established practice, not a widening.
#   The KEY still gains nothing but named words: [G1] is unchanged, and the
#   scheduler that holds the key remains a dumb clock.
#
# Exit codes: 0 ok/no-op · 1 failure (incl. [G9] no-manifest abort) ·
#             2 refused (bad action word) or CANNOT VERIFY (feedback-sync/
#               feedback-status/harvest-post with no readable token) · 3 active
################################################################################

set -uo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
IFS=$' \t\n'
umask 022

# ---- Hard-wired target [G2] -------------------------------------------------
SITE="nwd"
SITE_ROOT="/var/www/nwd"
DOCROOT="html"
FILES_PARENT="${SITE_ROOT}/${DOCROOT}/sites/default"
DOMAIN="nwd.nwpcode.org"
STATE_DIR="/var/lib/nwp-demo/${SITE}"
GOLDEN_DIR="${STATE_DIR}/golden"
GOLDEN_DB="golden.db.sql.gz"
GOLDEN_FILES="golden.files.tar.gz"
CODES_PAYLOAD="${STATE_DIR}/codes-payload.json"
STAMP_FILE="${STATE_DIR}/last-reset"
HARVEST_DIR="${STATE_DIR}/harvest"

# ---- Tester identity persistence (ops#369) ---------------------------------
# IDENTITY PERSISTS; CONTENT DOES NOT. A tester's login — username, mail,
# password hash (the one THEY chose), status, roles and the uuid the ssd half's
# UID lock is bound to — is carried across the wipe. Everything they AUTHORED
# is destroyed with the rest, which is the feature.
#
# TWO FILES, TWO DIFFERENT KINDS OF FACT, and they must not be conflated:
#
#   TESTERS_PAYLOAD  WHO is a tester. The console's tester registry, staged to
#                    this box exactly like the hashed invite-code payload
#                    (install-box.sh --stage-testers). It is the SOLE AUTHORITY
#                    on membership and it is READ FRESH FROM DISK on every
#                    invocation — never cached, never compiled into this file.
#                    It holds NO secrets: names only. root:root 0644.
#   TESTERS_CAPTURE  WHAT their login currently is. Written by the pre-wipe
#                    export from the LIVE database seconds before it is
#                    dropped, which is the only place a password the tester set
#                    themselves exists. It DOES hold password hashes, so its
#                    directory is 0700 and owned by the user this wrapper runs
#                    as, and no hash is ever printed or logged.
TESTERS_PAYLOAD="${STATE_DIR}/testers-payload.json"
TESTERS_DIR="${STATE_DIR}/testers"
TESTERS_CAPTURE="${TESTERS_DIR}/identity-latest.json"
# ---- Guild MEMBERSHIP persistence (ops#376) ---------------------------------
# MEMBERSHIP IS PART OF WHO A TESTER IS FOR TESTING. A tester who comes back
# with their password but outside their guild cannot reach the thing they were
# asked to test, so the login survived and the test did not.
#
# CONSENT IS NOT MEMBERSHIP AND IS DELIBERATELY NOT CARRIED HERE. Operator
# ruling 2026-08-16, on being asked to extend this leg: "yes extend to guild
# membership" — and explicitly NOT Article 9 consent. Consent is a legal record
# with its own lifecycle (nwc_art9_consent: granted/withdrawn/stale, currency,
# may_contribute, may_keep_formation) and it must move through that machinery,
# never be re-asserted by a nightly maintenance script on the strength of a
# reading taken a minute earlier. A reset that re-granted consent would be
# manufacturing a legal fact. If a later session is tempted: the answer is no,
# and this paragraph is why.
#
# SOJOURNER LEVEL IS ALSO NOT CARRIED, for a different reason: it is
# PROGRESSION, not membership. `nwc:tester-set-level` recomputes it from
# qualifying course completions, and the reset destroys those completions —
# so restoring a level would mean asserting completions that no longer exist.
# Membership is a fact about who someone is; level is a fact about what they
# have done, and this leg only restores the first.
TESTERS_GUILDS_CAPTURE="${TESTERS_DIR}/guilds-latest.json"
# The site's OWN commands, exactly like FEEDBACK_SYNC_CMD below: one API, one
# set of guarantees. `tester-set-guild` resolves a guild by
# field_group_seed_key via nwc_guild_load_seed_group() — the MACHINE key, never
# the mutable label, so the ADR-0029 label-rename hazard that left three
# personas group-less in ops#218 does not exist on this path. It REFUSES an
# unknown seed key and can only ever JOIN AN EXISTING GROUP: this leg therefore
# cannot create, rename or resurrect a guild, and the golden's guild set stays
# authoritative by construction rather than by our good behaviour.
TESTERS_LIST_CMD="nwc:tester-list"
TESTERS_SETGUILD_CMD="nwc:tester-set-guild"
# ONE individual-scope role can be set per membership: --group-role sets the
# role to EXACTLY THIS ID (measured off the deployed --help, 2026-08-16), so
# repeated calls REPLACE rather than accumulate. Live testers hold up to four at
# once (Benedict-0000: guild-admin, guild-mentor, guild-verifier, guild-endorsed
# in each of eight guilds), so a choice has to be made and it is made HERE, once,
# in the open:
#
#   PRECEDENCE, most-capable first. The role restored is always one the tester
#   PROVABLY HELD seconds before the wipe, so this can never widen anybody's
#   access; it only decides which of several held roles is the one that comes
#   back. Most-capable wins because the extras are the ones whose absence costs
#   least — a guild-admin demoted to guild-endorsed cannot run their guild at
#   all, whereas an admin who has lost `endorsed` can still work.
#
#   EVERY DROPPED ROLE IS COUNTED AND NAMED. Silent partial restoration is the
#   failure this whole feature exists to prevent, so `dropped_roles` is in the
#   verdict and the names are in the log.
#
# The real fix is a multi-role setter on the nwc side; until it exists this is
# a STATED limitation, not an unknown one (nwp/ops — see the MR).
TESTERS_ROLE_PRECEDENCE="guild-admin guild-mentor guild-verifier guild-editor guild-endorsed guild-junior"
# Roles group itself applies (the synchronized insider/outsider set). They are
# typed refusals on the write side, so they must never be offered to it.
TESTERS_ROLE_SYNTHETIC="guild-member guild-outsider guild-verified"
# The @demo.invalid fence (RFC 6761, reserved — mail can never leave the box) is
# the SAFETY NET, not the roster: NwcPrivacyDemoCommands fences every tester
# write on it and so does this. The registry says who is preserved; the fence
# says who may be touched at all. An account must satisfy BOTH.
TESTERS_FENCE="demo.invalid"
# A staged registry older than this is reported STALE. It is not a refusal —
# a stale roster still preserves the testers it names, and refusing would turn
# "the console did not re-stage" into "every tester lost tonight", which is the
# wrong direction. It IS surfaced by `status`.
TESTERS_STALE_AFTER=172800      # 48h
LOCK_FILE="/var/lock/nwd-demo-reset.lock"
LOG_FILE="/var/log/nwp-demo/nwd-demo-reset.log"

# ---- ops#315: the box's own GitLab legs ------------------------------------
# TOKEN_FILE holds the ONE walled api token (issue-write to the feedback + ops
# projects only — see private/secrets-registry.yml: demo_box_feedback_token).
# Root-owned 0600, written by the OPERATOR via pl secrets, never by this file
# and never by install-box.sh.
TOKEN_FILE="/etc/nwp-demo/feedback.token"
GITLAB_API="https://git.nwpcode.org/api/v4"
OPS_PROJECT_ID=21                     # nwp/ops — where harvest digests are filed
HARVEST_LABELS="demo-tester,auto-harvest"   # matches scripts/commands/demo.sh
# The module's own sync command + sentinels, byte-identical to lib/demo.sh
# (DEMO_FEEDBACK_*): one renderer, one probe, two hosts.
FEEDBACK_SYNC_CMD="nwc-feedback:sync-to-gitlab"
FEEDBACK_LIMIT=100
# The return leg (ops#219): same module, the polling sibling command.
FEEDBACK_STATUS_CMD="nwc-feedback:sync-status"
FEEDBACK_STATUS_LIMIT=50
FEEDBACK_NONE_MARKER="No feedback items pending GitLab sync"
# sync-status's EARLY RETURN when no escalated signal carries a GitLab link —
# byte-identical to NwcFeedbackCommands::syncStatus(). On a quiet hour this is
# the ONLY output: the `Done. advanced=…` summary line never prints, which is
# why every hourly run from 2026-08-09's arming logged `summary-unparsed`
# (ops#329 D4). An empty set is a PARSED zero, not an unparsed shrug.
FEEDBACK_STATUS_NONE_MARKER="No escalated signals with a GitLab link to check"
# ops#329 D5: the box's own nightly backup landing dir (written by the 01:30
# producer cron, gitlab-readable by design). `status` reports the newest file
# per subdir — names, sizes and ages only, never contents.
BACKUP_PULL_DIR="/var/backups/nwp-pull"
FEEDBACK_MIN_PROBE='echo method_exists(\Drupal::service("nwc_feedback.gitlab_sync"), "buildIssueDescription") ? "MINIMISED-OK" : "MINIMISATION-MISSING";'

DRUSH_SUDO=(sudo -u www-data)
DRUSH_BIN="./vendor/bin/drush"
ROOT_SUDO=(sudo)

TZ_MEL="Australia/Melbourne"
IDLE_WINDOW=1800        # 30 min — matches `pl demo reset --if-idle 30m`
MIN_INTERVAL=600        # 10 min hard floor between two real resets [G5]
SMOKE_ATTEMPTS=5
SMOKE_SLEEP=5
# [G10] Completion marker for the pending-update probe. A clean site prints
# NOTHING on stdout (drush puts "No database updates required" on stderr), so
# emptiness alone cannot tell "no updates" from "the probe never ran".
PENDING_MARKER='PENDING_UPDATES_PROBE_OK'

################################################################################
# Logging [G7]
################################################################################

log() {
    local event="$1" detail="${2:-}"
    local line rc=0
    line="$(date -u '+%Y-%m-%dT%H:%M:%SZ')|${event}|${detail}"
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    # The redirection itself is what can fail (unwritable log dir), so it is
    # wrapped — `>> f 2>/dev/null` would still print the shell's own error.
    { printf '%s\n' "$line" >> "$LOG_FILE"; } 2>/dev/null || rc=1
    printf '%s\n' "$line"
    # log() is still fail-SOFT for control flow — no caller is obliged to check,
    # nothing aborts merely because the log dir broke, and `status` keeps
    # answering. But it is now HONEST: the return code says whether the line was
    # actually PERSISTED, which is the one thing [G9] has to be able to ask.
    # Every other call site uses `log` in statement position, and this script
    # does not run under `set -e`, so a non-zero return changes nothing there.
    return "$rc"
}

die() { log "$1" "${2:-}"; echo "ERROR: ${1} ${2:-}" >&2; exit "${3:-1}"; }

# Sanitise a string for a single log field: strip newlines/pipes, cap length.
# The client controls $SSH_ORIGINAL_COMMAND, so it is scrubbed before it is
# written and is never used for anything else. [G1]
scrub() {
    printf '%s' "$1" | tr -d '\000-\037' | tr '|' '/' | cut -c1-200
}

################################################################################
# [G1] Action word: fixed literal allowlist, never executed as a command
################################################################################

# The action word arrives by exactly TWO routes, and until ops#329 D6 this read
# only the first:
#
#   1. the FORCED COMMAND route — the restricted key. sshd puts whatever the
#      client asked for in $SSH_ORIGINAL_COMMAND and runs this script with no
#      argv. This is how the nightly cron and `pl demo schedule --via-key` call.
#   2. the SUDO route — `ssh box "sudo /usr/local/bin/nwd-demo-reset-restricted
#      status"`, which is what `pl demo status --tier=live` and `pl demo harvest
#      --pull` fall back to on a host that has no restricted key. sudo's
#      env_reset strips $SSH_ORIGINAL_COMMAND (and $SSH_CLIENT), so here the
#      word can ONLY arrive in argv.
#
# MEASURED 2026-08-10 on the ssd half (this file has the identical defect and
# is fixed with it): reading route 1 alone meant a route-2 `status` resolved to
# the EMPTY string, fell into the `""|nightly)` arm, and asked the box to WIPE
# the site. The read-only monitoring probe was a destructive one. nwd escaped
# only because the dev workstation happens to hold ~/.ssh/nwd_demo_reset and so
# never took route 2 — an accident of which key is where, not a guarantee.
#
# argv is joined with "$*" on purpose: `status extra` must be ONE unrecognised
# string that the allowlist REFUSES, not a `status` with something ignored.
RAW_CMD="${SSH_ORIGINAL_COMMAND:-}"
ARGV_CMD="$*"
if [[ -z "$RAW_CMD" ]]; then
    RAW_CMD="$ARGV_CMD"
elif [[ -n "$ARGV_CMD" && "$ARGV_CMD" != "$RAW_CMD" ]]; then
    # Two different words in one invocation. There is no honest way to choose,
    # and the dangerous reading (fall back to nightly) is the one the old code
    # would have taken — so this is built to land in the REFUSED arm below.
    RAW_CMD="ambiguous: ssh='${RAW_CMD}' argv='${ARGV_CMD}'"
fi
CLIENT="${SSH_CLIENT:-local}"

resolve_action() {
    # Only these exact strings are honoured. Note the case arms are literals —
    # $RAW_CMD is compared, never expanded into a command position.
    case "$RAW_CMD" in
        ""|nightly)    echo "nightly" ;;
        reset)         echo "reset" ;;
        dry-run)       echo "dry-run" ;;
        status)        echo "status" ;;
        harvest)       echo "harvest" ;;
        feedback-sync) echo "feedback-sync" ;;
        feedback-status) echo "feedback-status" ;;
        harvest-post)  echo "harvest-post" ;;
        *)             echo "REFUSED" ;;
    esac
}

ACTION="$(resolve_action)"

if [[ "$ACTION" == "REFUSED" ]]; then
    log "rejected-command" "client=${CLIENT%% *} requested=$(scrub "$RAW_CMD")"
    cat >&2 <<EOF
REFUSED: this key may only run the nwd demo reset.
The command you sent was logged and NOT executed.
Allowed action words: (empty)|nightly | reset | dry-run | status | harvest | feedback-sync | feedback-status | harvest-post
EOF
    exit 2
fi

log "invoked" "action=${ACTION} client=${CLIENT%% *} original=$(scrub "$RAW_CMD")"

################################################################################
# status — read-only, no guards needed
################################################################################

if [[ "$ACTION" == "status" ]]; then
    echo "site:        ${SITE} (${DOMAIN})"
    echo "golden dir:  ${GOLDEN_DIR}"
    if [[ -s "${GOLDEN_DIR}/golden.manifest.json" ]]; then
        echo "golden:      captured $(jq -r '.captured_utc // "?"' "${GOLDEN_DIR}/golden.manifest.json" 2>/dev/null)"
    else
        echo "golden:      MISSING"
    fi
    echo "last reset:  $(cat "$STAMP_FILE" 2>/dev/null || echo none)"

    # ops#369 — TESTER IDENTITY PERSISTENCE. Three separate facts, never
    # collapsed: is a roster staged, how old is it, and did last night's run
    # actually carry the logins across. "No line at all" was the old answer to
    # all three and it is the one answer a tester cannot act on.
    if [[ ! -s "$TESTERS_PAYLOAD" ]]; then
        echo "testers_registry: NOT STAGED — no login survives a reset"
    elif ! jq -e '.version == 1 and (.testers|type=="array")' "$TESTERS_PAYLOAD" >/dev/null 2>&1; then
        echo "testers_registry: MALFORMED — no login survives a reset"
    else
        TS_N="$(jq -r '.testers | length' "$TESTERS_PAYLOAD" 2>/dev/null || echo '?')"
        TS_GEN="$(jq -r '.generated_utc // "?"' "$TESTERS_PAYLOAD" 2>/dev/null || echo '?')"
        TS_AGE="$(( $(date +%s) - $(stat -c%Y "$TESTERS_PAYLOAD" 2>/dev/null || date +%s) ))"
        TS_STALE=""
        [[ "$TS_AGE" -gt "$TESTERS_STALE_AFTER" ]] && TS_STALE=" STALE"
        echo "testers_registry: ${TS_N} tester(s) generated=${TS_GEN} staged_age=${TS_AGE}s${TS_STALE}"
    fi
    echo "last_testers_preserved: $(cat "${TESTERS_DIR}/last-verdict" 2>/dev/null || echo none)"
    # ops#376 — the MEMBERSHIP half, on its own line. Two lines rather than one
    # richer line because they are two different failures with two different
    # remedies: "they cannot log in" and "they can log in but are out of their
    # guild". A reader that only knows the old line still gets a true answer to
    # the question it asks, which is what makes this additive.
    echo "last_testers_guilds: $(cat "${TESTERS_DIR}/last-guilds" 2>/dev/null || echo none)"

    # ops#329 D4 — the return leg's last run, read from this box's OWN log
    # (the primary record; met's cron log is only the trigger transcript).
    # One structured line: the newest feedback-status-* record verbatim
    # (<utc>|<event>|<detail>), `none` when the leg has never run here, or a
    # named CANNOT-VERIFY when the log exists but cannot be read — three
    # states, never collapsed, never silent.
    if [[ -e "$LOG_FILE" && ! -r "$LOG_FILE" ]]; then
        echo "last_feedback_status: CANNOT-VERIFY log-unreadable"
    else
        FS_LAST="$(grep '|feedback-status-' "$LOG_FILE" 2>/dev/null | tail -1)"
        echo "last_feedback_status: ${FS_LAST:-none}"
    fi

    # ops#329 D5 — newest nightly backup per subdir of the box's pull dir.
    # Names, byte counts and mtimes only; no contents, no sudo (the dir is
    # gitlab-readable by design). A missing or unreadable dir is NAMED, an
    # empty subdir says `empty` — absence of backups must never render as
    # absence of the report.
    if [[ ! -d "$BACKUP_PULL_DIR" ]]; then
        echo "backups: ${BACKUP_PULL_DIR} MISSING"
    elif [[ ! -r "$BACKUP_PULL_DIR" || ! -x "$BACKUP_PULL_DIR" ]]; then
        echo "backups: ${BACKUP_PULL_DIR} UNREADABLE"
    else
        echo "backups: ${BACKUP_PULL_DIR}"
        BK_FOUND=0
        for BK_D in "$BACKUP_PULL_DIR"/*/; do
            [[ -d "$BK_D" ]] || continue
            BK_FOUND=1
            BK_SUB="$(basename "$BK_D")"
            BK_NEWEST="$(ls -1t "$BK_D" 2>/dev/null | head -1)"
            if [[ -n "$BK_NEWEST" && -f "${BK_D}${BK_NEWEST}" ]]; then
                BK_BYTES="$(stat -c%s "${BK_D}${BK_NEWEST}" 2>/dev/null || echo '?')"
                BK_MTIME="$(date -u -r "${BK_D}${BK_NEWEST}" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo '?')"
                echo "backup: ${BK_SUB}|newest=${BK_NEWEST}|bytes=${BK_BYTES}|mtime=${BK_MTIME}"
            else
                echo "backup: ${BK_SUB}|empty"
            fi
        done
        [[ "$BK_FOUND" -eq 1 ]] || echo "backup: none"
    fi

    echo "--- last 15 log lines ---"
    tail -n 15 "$LOG_FILE" 2>/dev/null || true
    exit 0
fi

################################################################################
# harvest — DRAIN the spooled error digests to stdout (read-only)
#
# The pre-wipe harvest has always WRITTEN digests here, and nothing ever
# collected them: they aged out of the 30-file window and every error a tester
# ever hit on live was lost silently. That is the pilot's entire point going
# missing, so this is the other half of the loop.
#
# READ-ONLY ON PURPOSE. It emits and deletes nothing, so a failed or half-read
# drain loses nothing and can simply be re-run. Marking files "sent" from here
# would mean this restricted key could destroy evidence, and would put the
# only record of a bad night one crashed pipe away from gone. The consumer
# deduplicates by filename against what it has already posted.
#
# The envelope is a fixed literal so the consumer can split a stream of digests
# without guessing where one ends.
################################################################################

if [[ "$ACTION" == "harvest" ]]; then
    if [[ ! -d "$HARVEST_DIR" ]]; then
        echo "NWP-HARVEST-EMPTY"
        exit 0
    fi
    n=0
    for f in $(ls -1t "${HARVEST_DIR}"/harvest-*.txt 2>/dev/null); do
        [[ -s "$f" ]] || continue
        echo "NWP-HARVEST-BEGIN $(basename "$f")"
        cat "$f"
        echo "NWP-HARVEST-END $(basename "$f")"
        n=$(( n + 1 ))
    done
    [[ "$n" -eq 0 ]] && echo "NWP-HARVEST-EMPTY"
    log "harvest-drained" "files=${n} client=${CLIENT%% *}"
    exit 0
fi

################################################################################
# ops#315 shared helper: the walled api token, or empty. Never printed, never
# logged, never in any argv this wrapper builds for curl.
################################################################################

box_token() {
    "${ROOT_SUDO[@]}" cat "$TOKEN_FILE" 2>/dev/null | tr -d '[:space:]'
}

################################################################################
# feedback-sync — push pending tester Feedback to GitLab BEFORE the wipe
# (ops#315; the box-side twin of lib/demo.sh:demo_feedback_sync, same four
# stages in the same order so the two implementations cannot disagree about
# what may leave: probe → ops#140 interlock → token → push).
#
# nwd-ONLY BY DESIGN: Moodle's local_feedback forwards each report at submit
# time, so the ssd wrapper deliberately does not know this word.
#
# Deliberately LOCKLESS, like `harvest`: the verb sequences it before the
# reset, and a stray overlap costs at worst a failed drush call (exit 1,
# retryable) — never a wrong push and never a blocked reset.
################################################################################

if [[ "$ACTION" == "feedback-sync" ]]; then
    # 1. Is anything pending? --dry-run needs NO token and makes no network
    #    call, so a quiet night on an unprovisioned box is a clean no-op.
    FB_OUT="$( cd "$SITE_ROOT" \
               && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" "$FEEDBACK_SYNC_CMD" \
                    --dry-run --limit=1 2>/dev/null )" || {
        log "feedback-sync-failed" "stage=probe"
        echo "FAIL  could not probe the pending feedback set." >&2
        exit 1
    }
    if [[ "$FB_OUT" == *"$FEEDBACK_NONE_MARKER"* ]]; then
        log "feedback-sync-empty" "nothing pending"
        echo "OK  no tester feedback pending — nothing to sync."
        exit 0
    fi

    # 2. ops#140 INTERLOCK — minimised, or nothing leaves this box. The gate
    #    checks the DEPLOYED module code, which lives here anyway; an
    #    unreadable answer is a refusal, not a pass.
    FB_MIN="$( cd "$SITE_ROOT" \
               && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" php:eval "$FEEDBACK_MIN_PROBE" 2>/dev/null )" || FB_MIN=""
    if [[ "$FB_MIN" != *MINIMISED-OK* ]]; then
        log "feedback-sync-refused" "reason=minimisation-unverified"
        echo "REFUSED  the deployed nwc_feedback does not provably carry the ops#140 minimisation — nothing was sent." >&2
        echo "         Deploy nwc main (MR nwp/nwc!50 or later), then re-run." >&2
        exit 1
    fi

    # 3. Token — read only once there is something minimised to send. Missing
    #    is CANNOT VERIFY: feedback IS pending and this leg could not run.
    FB_TOKEN="$(box_token)"
    if [[ -z "$FB_TOKEN" ]]; then
        log "feedback-sync-no-token" "file=${TOKEN_FILE}"
        cat >&2 <<EOF
CANNOT VERIFY  no api token at ${TOKEN_FILE} — tester feedback IS pending and was NOT pushed.
Provisioning is an OPERATOR step (registry entry demo_box_feedback_token); this wrapper never mints or holds one.
EOF
        exit 2
    fi

    # 4. Push through the module's own command. Same stated exposure as
    #    lib/demo.sh: --token= is argv-visible to ps for the life of the call;
    #    the identity is a walled issue-write bot, it is never printed or
    #    logged here, and anything drush echoes back is redacted below.
    FB_RC=0
    FB_OUT="$( cd "$SITE_ROOT" \
               && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" "$FEEDBACK_SYNC_CMD" \
                    --limit=${FEEDBACK_LIMIT} "--token=${FB_TOKEN}" 2>&1 )" || FB_RC=$?
    FB_OUT="${FB_OUT//"$FB_TOKEN"/<redacted>}"
    FB_TOKEN=""
    if (( FB_RC != 0 )); then
        log "feedback-sync-failed" "stage=push rc=${FB_RC}"
        printf '%s\n' "$FB_OUT"
        exit 1
    fi
    FB_N="$(printf '%s\n' "$FB_OUT" | grep -c '\[OK\] feedback #')" || FB_N=0
    log "feedback-sync-ok" "synced=${FB_N}"
    printf '%s\n' "$FB_OUT"
    echo "OK  feedback-sync complete (synced=${FB_N})."
    exit 0
fi

################################################################################
# feedback-status — the RETURN leg (ops#219 Phase A)
#
# The module's own nwc-feedback:sync-status: for every signal with a GitLab
# ref still open in the lifecycle it captures the linked MR + preview URL, and
# when the issue has CLOSED it advances the signal fixed → poster_invited and
# emails the reporter the "please check this" invitation. Until this runs on a
# schedule, /my/feedback shows every reporter "Sent to the team" for ever.
#
# nwd-ONLY like feedback-sync: the pending set and /my/feedback are Drupal
# (nwc_feedback) concepts; the ssd wrapper deliberately refuses the word.
#
# Unlike feedback-sync there is no token-free probe stage: sync-status cannot
# even LOOK at GitLab without a token, so a missing token is CANNOT VERIFY
# immediately — reporters keep seeing stale state and this leg says so.
#
# Deliberately LOCKLESS, like feedback-sync: it never touches the golden or the
# stamp, and a stray overlap with the nightly costs at worst a failed drush
# call (exit 1, retried on the next hour) — never a wrong state transition.
################################################################################

if [[ "$ACTION" == "feedback-status" ]]; then
    FS_TOKEN="$(box_token)"
    if [[ -z "$FS_TOKEN" ]]; then
        log "feedback-status-no-token" "file=${TOKEN_FILE}"
        cat >&2 <<EOF
CANNOT VERIFY  no api token at ${TOKEN_FILE} — the return leg did NOT run; reporters keep seeing stale feedback state.
Provisioning is an OPERATOR step (registry entry demo_box_feedback_token); this wrapper never mints or holds one.
EOF
        exit 2
    fi

    # Same stated exposure as feedback-sync: --token= is argv-visible to ps for
    # the life of the call; the identity is a walled issue-read/write bot, it is
    # never printed or logged here, and anything drush echoes back is redacted.
    FS_RC=0
    FS_OUT="$( cd "$SITE_ROOT" \
               && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" "$FEEDBACK_STATUS_CMD" \
                    --limit=${FEEDBACK_STATUS_LIMIT} "--token=${FS_TOKEN}" 2>&1 )" || FS_RC=$?
    FS_OUT="${FS_OUT//"$FS_TOKEN"/<redacted>}"
    FS_TOKEN=""
    if (( FS_RC != 0 )); then
        log "feedback-status-failed" "rc=${FS_RC}"
        printf '%s\n' "$FS_OUT"
        echo "FAIL  feedback-status (return leg) failed rc=${FS_RC} — reporters are seeing stale state." >&2
        exit 1
    fi
    # The command's own summary line: "Done. advanced=N drafts_captured=N checked=N".
    # That line only prints when there WAS something to check — the empty set
    # returns early with FEEDBACK_STATUS_NONE_MARKER and no counts at all, so
    # it is folded to an explicit zero (ops#329 D4; before this, every quiet
    # hour logged `summary-unparsed` and the counts were dropped on the floor).
    # Anything matching NEITHER shape still logs summary-unparsed: an output
    # format this wrapper does not recognise is a fact worth keeping visible.
    FS_SUM="$(printf '%s\n' "$FS_OUT" | grep -o 'advanced=[0-9]* drafts_captured=[0-9]* checked=[0-9]*' | tail -1)"
    if [[ -z "$FS_SUM" && "$FS_OUT" == *"$FEEDBACK_STATUS_NONE_MARKER"* ]]; then
        FS_SUM="advanced=0 drafts_captured=0 checked=0"
    fi
    log "feedback-status-ok" "${FS_SUM:-summary-unparsed}"
    printf '%s\n' "$FS_OUT"
    echo "OK  feedback-status complete${FS_SUM:+ (${FS_SUM})}."
    exit 0
fi

################################################################################
# harvest-post — post the spooled pre-wipe digests to nwp/ops (ops#315)
#
# The write-side complement of the read-only `harvest` drain: GitLab confirms
# an iid, THEN the digest moves to posted/ — a failed post keeps the file in
# the spool for the next attempt, so a crashed pipe loses nothing (the same
# retry-safe contract as `pl demo harvest-post`). Each posted file is named on
# stdout machine-readably (NWP-HARVEST-POSTED <basename> iid=<iid>) so the
# calling verb can mark its own pulled copy and never double-post.
################################################################################

if [[ "$ACTION" == "harvest-post" ]]; then
    HP_TOKEN="$(box_token)"
    if [[ -z "$HP_TOKEN" ]]; then
        log "harvest-post-no-token" "file=${TOKEN_FILE}"
        cat >&2 <<EOF
CANNOT VERIFY  no api token at ${TOKEN_FILE} — spooled digests were NOT posted and are KEPT in ${HARVEST_DIR}.
Provisioning is an OPERATOR step (registry entry demo_box_feedback_token); this wrapper never mints or holds one.
EOF
        exit 2
    fi
    if [[ ! -d "$HARVEST_DIR" ]]; then
        HP_TOKEN=""
        log "harvest-post-done" "posted=0 failed=0 (no spool)"
        echo "OK  no harvest spool — nothing to post."
        exit 0
    fi

    # posted/ must be a directory THIS user can write, or a confirmed post
    # cannot be moved out of the spool — and a posted-but-not-moved digest is
    # filed AGAIN on the next run. Found live 2026-08-09: posted/ was
    # root-owned (created by a sudo-run drain), every mv failed silently after
    # GitLab had already confirmed the issue. So: repair the ownership via
    # sudo first (the wrapper's user is the intended owner), and if posted/
    # still cannot be a writable dir, REFUSE before posting anything — the
    # fail-closed direction is "no post", never "post and double-file".
    "${ROOT_SUDO[@]}" install -d -o "$(id -un)" -g "$(id -gn)" -m 0755 \
        "${HARVEST_DIR}/posted" 2>/dev/null \
        || mkdir -p "${HARVEST_DIR}/posted" 2>/dev/null || true
    if [[ ! -d "${HARVEST_DIR}/posted" || ! -w "${HARVEST_DIR}/posted" ]]; then
        HP_TOKEN=""
        log "harvest-post-refused" "reason=posted-dir-unusable"
        cat >&2 <<EOF
REFUSED  ${HARVEST_DIR}/posted is not a writable directory and could not be repaired.
Posting anyway would leave every posted digest in the spool and double-post it on the next run — nothing was sent.
EOF
        exit 1
    fi

    # The token travels in a 0600 curl config, never in curl's argv (argv is
    # world-readable via ps; the config file is not).
    HP_CFG="$(umask 077 && mktemp)" || { HP_TOKEN=""; die "harvest-post-failed" "cannot create curl config"; }
    trap 'rm -f "$HP_CFG"' EXIT
    printf 'header = "PRIVATE-TOKEN: %s"\n' "$HP_TOKEN" > "$HP_CFG"
    HP_TOKEN=""

    HP_POSTED=0; HP_FAILED=0
    for HP_F in $(ls -1 "${HARVEST_DIR}"/harvest-*.txt 2>/dev/null | sort); do
        [[ -s "$HP_F" ]] || continue
        HP_BASE="$(basename "$HP_F")"
        HP_WHEN="${HP_BASE#harvest-}"; HP_WHEN="${HP_WHEN%.txt}"
        HP_TITLE="Demo harvest — ${SITE}: errors before the ${HP_WHEN} reset"
        HP_BODY="$(printf 'harvested_utc: %s\n\nPre-wipe error digest posted from the %s live box.\n\n```\n%s\n```\n' \
                        "$HP_WHEN" "$SITE" "$(cat "$HP_F")")"
        HP_PAYLOAD="$(jq -nc --arg t "$HP_TITLE" --arg d "$HP_BODY" --arg l "$HARVEST_LABELS" \
                        '{title:$t, description:$d, labels:$l}')" || {
            log "harvest-post-failed" "file=${HP_BASE} reason=payload"
            HP_FAILED=$(( HP_FAILED + 1 )); continue; }
        HP_RESP="$(curl -sS -K "$HP_CFG" --max-time 30 -H 'Content-Type: application/json' \
                        -d "$HP_PAYLOAD" "${GITLAB_API}/projects/${OPS_PROJECT_ID}/issues" 2>/dev/null)" || HP_RESP=""
        HP_IID="$(printf '%s' "$HP_RESP" | jq -r '.iid // empty' 2>/dev/null)"
        if [[ -n "$HP_IID" ]]; then
            # The move is part of the post: a digest GitLab confirmed but the
            # spool still holds is a double-post on the next run, so a failed
            # mv is a loud FAILURE (the POSTED line still prints — it is true,
            # and the pulling verb needs it to dedup its own copy).
            if mv "$HP_F" "${HARVEST_DIR}/posted/${HP_BASE}" 2>/dev/null; then
                log "harvest-posted" "file=${HP_BASE} issue=#${HP_IID}"
                echo "NWP-HARVEST-POSTED ${HP_BASE} iid=${HP_IID}"
                HP_POSTED=$(( HP_POSTED + 1 ))
            else
                log "harvest-posted-not-moved" "file=${HP_BASE} issue=#${HP_IID} DOUBLE-POST-HAZARD"
                echo "NWP-HARVEST-POSTED ${HP_BASE} iid=${HP_IID}"
                echo "FAIL  ${HP_BASE} was POSTED as #${HP_IID} but could NOT be moved to posted/ — move it by hand or it will double-post next run." >&2
                HP_FAILED=$(( HP_FAILED + 1 ))
            fi
        else
            log "harvest-post-failed" "file=${HP_BASE}"
            echo "FAIL  ${HP_BASE} — not posted (kept in the spool for retry)" >&2
            HP_FAILED=$(( HP_FAILED + 1 ))
        fi
    done
    rm -f "$HP_CFG"; trap - EXIT
    # posted/ is bounded like the spool itself (the box is small); the drain's
    # consumer keeps its own copies, so pruning here destroys no last record.
    ls -1t "${HARVEST_DIR}/posted"/harvest-*.txt 2>/dev/null | tail -n +61 | xargs -r rm -f
    log "harvest-post-done" "posted=${HP_POSTED} failed=${HP_FAILED}"
    echo "OK  harvest-post: posted=${HP_POSTED} failed=${HP_FAILED}"
    [[ "$HP_FAILED" -eq 0 ]] || exit 1
    exit 0
fi

################################################################################
# [G6] Single-flight
################################################################################

exec 9>"$LOCK_FILE" 2>/dev/null || true
if ! flock -n 9; then
    log "skip-locked" "another reset is already running"
    echo "Another nwd demo reset is already running — nothing to do."
    exit 0
fi

################################################################################
# Helpers
################################################################################

drush() { ( cd "$SITE_ROOT" && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" "$@" ); }

mel_today() { TZ="$TZ_MEL" date '+%Y-%m-%d'; }

# [G3] Fail-closed golden verification: manifest names THIS site and both
# artifacts match their sha256 sidecars. Identical contract to
# lib/demo.sh:demo_golden_verify, reimplemented here so the box needs no repo.
golden_verify() {
    local manifest="${GOLDEN_DIR}/golden.manifest.json"
    [[ -s "$manifest" ]] || { echo "no golden manifest at $manifest" >&2; return 1; }
    jq -e . "$manifest" >/dev/null 2>&1 || { echo "golden manifest is not valid JSON" >&2; return 1; }
    local msite; msite="$(jq -r '.site // empty' "$manifest")"
    [[ "$msite" == "$SITE" ]] || { echo "golden manifest is for site '$msite', not '$SITE'" >&2; return 1; }
    local f
    for f in "$GOLDEN_DB" "$GOLDEN_FILES"; do
        [[ -f "${GOLDEN_DIR}/${f}" && -f "${GOLDEN_DIR}/${f}.sha256" ]] || {
            echo "golden artifact or sidecar missing: ${GOLDEN_DIR}/${f}" >&2; return 1; }
        ( cd "$GOLDEN_DIR" && sha256sum -c "${f}.sha256" >/dev/null 2>&1 ) || {
            echo "sha256 MISMATCH for ${f} — golden corrupt" >&2; return 1; }
    done
    return 0
}

# [G2] The live site must report demo_mode = true. This is the check that stops
# this script from ever wiping a non-demo site, even if SITE_ROOT were wrong.
require_demo_mode() {
    local val
    val="$(drush cget nwc_demo_access.settings demo_mode --format=string 2>/dev/null | tr -d '[:space:]')"
    case "$val" in
        1|true|TRUE) return 0 ;;
    esac
    echo "site does not report demo_mode=true (got '${val:-<none>}')" >&2
    return 1
}

# [G4] Idle guard. Empty/garbled result → treat as ACTIVE. Never wipe on bad data.
newest_session() {
    drush sqlq 'SELECT COALESCE(MAX(timestamp),0) FROM sessions' 2>/dev/null | tr -d '[:space:]'
}

idle_ok() {
    local newest="$1" now age
    [[ "$newest" =~ ^[0-9]+$ ]] || return 1     # garbled → ACTIVE
    now="$(date +%s)"
    [[ "$newest" -eq 0 ]] && return 0           # no sessions at all → idle
    age=$(( now - newest ))
    [[ "$age" -ge "$IDLE_WINDOW" ]]
}

################################################################################
# TESTER IDENTITY PERSISTENCE (ops#369)
#
# THE OPERATOR'S QUESTION, VERBATIM: "If I give someone a login and they change
# the password does it survive to the next day?" Until this block it did not,
# and the loss had two different shapes, both measured on live 2026-08-15:
#
#   * a tester WHO WAS IN THE GOLDEN kept their username and uuid but their
#     chosen password reverted to whatever the golden held
#     (Benedict-0000: $2y$12$IrJ4… before the reset, $2y$10$Wq9z… after);
#   * a tester who joined AFTER the seal was erased outright — no row at all
#     (tester_daytwo, uid 41, gone).
#
# So a tester had to ask for a new invite code every single day. The fix is a
# pre-wipe EXPORT and a post-import RESTORE, in the same idiom as the harvest
# and feedback-sync legs above.
#
# WHY NOT JUST BAKE TESTERS INTO THE GOLDEN: because then every password change
# would need a re-bless of the golden, and the operator's phase-1 ruling is that
# routine operation must not require one.
#
# COLLISION RULE — the uuid is the identity, the name is not:
#   1. a restored user with the SAME UUID  → UPDATE it (this is the normal case;
#      the golden brought the tester back and we are re-applying their password)
#   2. no such uuid, but the name is TAKEN → REFUSE that tester and degrade the
#      run. The golden's account wins: silently overwriting it could hand a
#      tester somebody else's account, including an administrator's.
#   3. neither → CREATE, carrying the original uuid so the ssd half's UID lock
#      (mdl_user.idnumber = this uuid) still finds them.
# uid is deliberately NOT preserved: after a restore Drupal's uid sequence
# rewinds to the golden's high-water mark, so yesterday's uid 41 is tomorrow's
# uid 41 for a DIFFERENT person. The uuid does not rewind.
################################################################################

# Set by testers_export / testers_restore, read by the exit-status block.
TESTERS_VERDICT="not-run"
TESTERS_DETAIL=""

# ops#376 — the GUILD MEMBERSHIP half, kept in SEPARATE variables on purpose.
# PARTIAL DEGRADATION IS THE REQUIREMENT: a membership that could not be carried
# across must not cost the tester their login as well. Two verdicts means the
# identity leg can succeed while the guild leg fails, and `status` says exactly
# that instead of collapsing both into one word an operator cannot act on.
GUILDS_VERDICT="not-run"
GUILDS_DETAIL=""
TESTERS_ROSTER=""

# SQL-safe? The registry is a file this box does not author, so every account
# name out of it is checked before it is ever interpolated into SQL. The set is
# the same one `pl demo testers` validates on the way in.
testers_name_ok() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.@-]{0,79}$ ]]
}

# Read the staged registry FRESH and print one validated account name per line.
# Exit: 0 = a roster (possibly empty), 1 = malformed, 2 = not staged.
# Refusals are printed on stderr so the caller can log them; names on stdout.
testers_roster() {
    [[ -s "$TESTERS_PAYLOAD" ]] || return 2
    jq -e '.version == 1 and (.testers | type == "array")' \
        "$TESTERS_PAYLOAD" >/dev/null 2>&1 || return 1
    local n bad=0
    # An entry the write side marked pending must never be honoured here. The
    # roster is BY DEFINITION the approved list — this is belt and braces, so a
    # write-side bug surfaces as a loud refusal rather than as a stranger
    # silently acquiring a persistent login.
    while IFS= read -r n; do
        if [[ "$(jq -r --arg n "$n" \
                '.testers[] | select(.account == $n)
                 | if (.approved == false or .status == "pending") then "no" else "yes" end' \
                "$TESTERS_PAYLOAD" 2>/dev/null | head -1)" != "yes" ]]; then
            echo "not-approved:${n}" >&2; bad=$(( bad + 1 )); continue
        fi
        if testers_name_ok "$n"; then
            printf '%s\n' "$n"
        else
            echo "bad-name:$(scrub "$n")" >&2; bad=$(( bad + 1 ))
        fi
    done < <(jq -r '.testers[]? | .account // empty' "$TESTERS_PAYLOAD" 2>/dev/null)
    [[ "$bad" -eq 0 ]]
}

# ---- PRE-WIPE EXPORT --------------------------------------------------------
# Fail-OPEN for the reset (a broken export must never leave the demo down) and
# fail-LOUD for the report: TESTERS_VERDICT is what stops the run being stamped
# as clean. An unpreserved tester who believes they are preserved is worse than
# a known gap.
testers_export() {
    local roster rrc=0
    roster="$(testers_roster 2>/tmp/nwd-testers-refusals.$$)" || rrc=$?
    local refusals; refusals="$(tr '\n' ' ' < /tmp/nwd-testers-refusals.$$ 2>/dev/null)"
    rm -f /tmp/nwd-testers-refusals.$$

    case "$rrc" in
        2)  TESTERS_VERDICT="not-staged"
            log "testers-registry-absent" "no roster at ${TESTERS_PAYLOAD} — NOTHING is preserved across this reset"
            echo "WARN  no tester registry is staged on this box — no login will survive this reset."
            echo "WARN  Stage it from the registry home: bash servers/live/demo/install-box.sh nwd --stage-testers"
            return 0 ;;
        1)  TESTERS_VERDICT="malformed"
            TESTERS_DETAIL="registry unparseable"
            log "testers-registry-malformed" "file=${TESTERS_PAYLOAD} — preserving NOTHING"
            echo "FAIL  the staged tester registry is not a version-1 roster — NO tester identity is preserved tonight." >&2
            return 1 ;;
    esac

    mkdir -p "$TESTERS_DIR" 2>/dev/null || true
    chmod 0700 "$TESTERS_DIR" 2>/dev/null || true

    # The validated roster, published for the ops#376 guild leg. It is EXACTLY
    # the set this function already accepted — the membership export must never
    # re-derive who is a tester, or the two legs could disagree about it.
    TESTERS_ROSTER="$roster"

    local listed=0 captured=0 absent=0 rows="" name row
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        listed=$(( listed + 1 ))
        # The fence is applied IN the query: an account off @demo.invalid, or
        # uid<=1, cannot be captured at all, whatever the registry says.
        # Plain columns, NOT CONCAT_WS('\t', …): drush sqlq already emits real
        # TAB-separated columns, whereas the '\t' in a CONCAT_WS reached MySQL
        # as a literal backslash-t and the field split below silently produced
        # one unsplit blob — every tester counted `absent` and preserved
        # nothing, while the run still said "captured 0/9" as if that were an
        # answer. Measured on live 2026-08-15; this comment is the fix's receipt.
        row="$(drush sqlq "SELECT ufd.name, ufd.mail, u.uuid, ufd.pass, ufd.status
                             FROM users_field_data ufd JOIN users u ON u.uid = ufd.uid
                            WHERE ufd.uid > 1
                              AND ufd.mail LIKE '%@${TESTERS_FENCE}'
                              AND ufd.name = '${name}' LIMIT 1" 2>/dev/null | head -1)"
        if [[ -z "$row" ]]; then
            absent=$(( absent + 1 )); continue
        fi
        local rname rmail ruuid rpass rstatus rroles
        IFS=$'\t' read -r rname rmail ruuid rpass rstatus <<<"$row"
        [[ -n "$ruuid" && -n "$rpass" ]] || { absent=$(( absent + 1 )); continue; }
        rroles="$(drush sqlq "SELECT roles_target_id FROM user__roles ur
                                JOIN users_field_data ufd ON ufd.uid = ur.entity_id
                               WHERE ufd.name = '${name}'" 2>/dev/null | tr '\n' ',' )"
        rows+="$(jq -cn --arg n "$rname" --arg m "$rmail" --arg u "$ruuid" \
                       --arg p "$rpass" --arg s "$rstatus" --arg r "${rroles%,}" \
                    '{name:$n, mail:$m, uuid:$u, pass:$p, status:$s,
                      roles:($r | split(",") | map(select(length>0)))}')"$'\n'
        captured=$(( captured + 1 ))
    done <<<"$roster"

    # ANOMALY: a REAL tester account the registry does not name. Under the
    # approval model there are no unapproved accounts, so this means either
    # someone holds a login nobody approved or the registry has drifted behind
    # the site. Named, counted, and it degrades the run.
    #
    # `demo_%` and `nwcdemo_%` are EXCLUDED and the exclusion is load-bearing,
    # not a convenience: those are the seeded persona and matrix fixtures that
    # `drush nwc:seed-demo` recreates on every reset (NwcPrivacyDemoCommands
    # calls them the `persona` and `matrix` fences). They are furniture, not
    # people, nobody approves them, and counting them here would make this
    # check permanently red — which is the fastest way to teach an operator to
    # ignore it. What is left is exactly the module's `redeemed` class: humans.
    local unlisted_n=0 unlisted_names=""
    unlisted_names="$(drush sqlq "SELECT name FROM users_field_data
                                   WHERE uid > 1 AND mail LIKE '%@${TESTERS_FENCE}'
                                     AND name NOT LIKE 'demo\_%' ESCAPE '\\\\'
                                     AND name NOT LIKE 'nwcdemo\_%' ESCAPE '\\\\'" 2>/dev/null \
                      | while IFS= read -r u; do
                            [[ -n "$u" ]] || continue
                            printf '%s\n' "$roster" | grep -qxF "$u" || printf '%s ' "$u"
                        done)"
    unlisted_n="$(printf '%s' "$unlisted_names" | wc -w | tr -d ' ')"

    if ! jq -cs --arg utc "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
              '{version:1, captured_utc:$utc, testers:.}' \
              >"${TESTERS_CAPTURE}.new" <<<"$rows" 2>/dev/null; then
        TESTERS_VERDICT="export-failed"
        TESTERS_DETAIL="could not write the capture"
        log "testers-export-failed" "stage=write listed=${listed}"
        echo "FAIL  could not write the tester identity capture — NO login is preserved tonight." >&2
        return 1
    fi
    chmod 0600 "${TESTERS_CAPTURE}.new" 2>/dev/null || true
    mv -f "${TESTERS_CAPTURE}.new" "$TESTERS_CAPTURE" 2>/dev/null || {
        TESTERS_VERDICT="export-failed"
        log "testers-export-failed" "stage=rename"
        echo "FAIL  could not commit the tester identity capture — NO login is preserved tonight." >&2
        return 1
    }

    # EVERY name listed and NOT ONE captured is not a roster of nine people who
    # have never signed in — it is an export that is not working. This exact
    # shape shipped and ran green on live once (the CONCAT_WS('\t') bug above):
    # `captured=0/9` printed, the reset stamped itself OK, and every tester was
    # wiped. A measurement that returns nothing for everyone must fail closed.
    if [[ "$listed" -gt 0 && "$captured" -eq 0 ]]; then
        TESTERS_VERDICT="export-blind"
        TESTERS_DETAIL="listed=${listed} captured=0"
        log "testers-export-blind" "listed=${listed} captured=0 — treating as CANNOT VERIFY, not as 'nobody is here'"
        echo "FAIL  the registry names ${listed} tester(s) and NOT ONE could be read from the database." >&2
        echo "      That is an export that cannot see, not a site with no testers. Nothing is preserved tonight." >&2
        return 1
    fi

    TESTERS_VERDICT="exported"
    TESTERS_DETAIL="listed=${listed} captured=${captured} absent=${absent} unlisted=${unlisted_n}"
    log "testers-exported" "${TESTERS_DETAIL}${refusals:+ refused=${refusals}}"
    echo "OK  tester identities captured: ${captured}/${listed} (no hash is printed or logged)"
    [[ "$absent" -gt 0 ]] && \
        echo "..  ${absent} registry entr(y|ies) have no account on this site yet — nothing to preserve for them."
    if [[ "$unlisted_n" -gt 0 ]]; then
        log "testers-unlisted-accounts" "count=${unlisted_n} names=$(scrub "$unlisted_names")"
        echo "FAIL  ANOMALY: ${unlisted_n} fenced account(s) exist that the registry does not name: ${unlisted_names}"
        echo "      Under the approval model no such account should exist. They are NOT preserved."
        TESTERS_VERDICT="unlisted-accounts"
        return 1
    fi
    [[ -n "$refusals" ]] && { TESTERS_VERDICT="registry-entries-refused"; TESTERS_DETAIL="$refusals"
        echo "FAIL  registry entries refused (not preserved): ${refusals}" >&2; return 1; }
    return 0
}

# ---- POST-IMPORT RESTORE ----------------------------------------------------
testers_restore() {
    [[ -s "$TESTERS_CAPTURE" ]] || { log "testers-restore-skipped" "no capture to restore"; return 0; }
    jq -e '.version == 1 and (.testers|type=="array")' "$TESTERS_CAPTURE" >/dev/null 2>&1 || {
        TESTERS_VERDICT="capture-malformed"
        log "testers-restore-failed" "capture unreadable"
        echo "FAIL  the tester identity capture is unreadable — testers were NOT restored." >&2
        return 1
    }

    local updated=0 created=0 collided=0 failed=0 t
    while IFS= read -r t; do
        [[ -n "$t" ]] || continue
        local name mail uuid pass status roles uid
        name="$(jq -r '.name'   <<<"$t")"; mail="$(jq -r '.mail'   <<<"$t")"
        uuid="$(jq -r '.uuid'   <<<"$t")"; pass="$(jq -r '.pass'   <<<"$t")"
        status="$(jq -r '.status' <<<"$t")"
        roles="$(jq -r '.roles[]?' <<<"$t" | tr '\n' ' ')"
        testers_name_ok "$name" || { failed=$(( failed + 1 )); continue; }
        [[ "$uuid" =~ ^[0-9a-f-]{36}$ && "$status" =~ ^[01]$ ]] || { failed=$(( failed + 1 )); continue; }

        # (1) same uuid → the golden brought them back; re-apply their login.
        uid="$(drush sqlq "SELECT uid FROM users WHERE uuid = '${uuid}' LIMIT 1" 2>/dev/null | tr -dc '0-9')"
        if [[ -z "$uid" ]]; then
            # (2) name taken by a DIFFERENT account → refuse, never clobber.
            if [[ -n "$(drush sqlq "SELECT uid FROM users_field_data WHERE name = '${name}' LIMIT 1" 2>/dev/null | tr -dc '0-9')" ]]; then
                collided=$(( collided + 1 ))
                log "testers-restore-collision" "name=${name} — a DIFFERENT account already holds this name; not overwritten"
                continue
            fi
            # (3) create, carrying the original uuid so ssd's UID lock still binds.
            if ! drush user:create "$name" --mail="$mail" >/dev/null 2>&1; then
                failed=$(( failed + 1 )); continue
            fi
            uid="$(drush sqlq "SELECT uid FROM users_field_data WHERE name = '${name}' LIMIT 1" 2>/dev/null | tr -dc '0-9')"
            [[ -n "$uid" ]] || { failed=$(( failed + 1 )); continue; }
            drush sqlq "UPDATE users SET uuid = '${uuid}' WHERE uid = ${uid}" >/dev/null 2>&1 || true
            created=$(( created + 1 ))
        else
            updated=$(( updated + 1 ))
        fi

        # uid<=1 is never a tester. Belt and braces around a uuid collision with
        # the site administrator: a console that hands out root while saying
        # "this is your tester login" is the accident this line exists to stop.
        [[ "$uid" -gt 1 ]] || { failed=$(( failed + 1 )); continue; }

        # The password hash is written straight to the column ON PURPOSE: drush
        # has no "set this bcrypt hash" verb, and re-hashing is not possible —
        # the plaintext exists only in the tester's head. Restoring a hash IS
        # what a restore is.
        drush sqlq "UPDATE users_field_data SET pass = '${pass}', mail = '${mail}', status = ${status}
                     WHERE uid = ${uid}" >/dev/null 2>&1 || failed=$(( failed + 1 ))
        local r
        for r in $roles; do
            [[ "$r" =~ ^[a-z0-9_]{1,64}$ ]] || continue
            [[ "$r" == "administrator" ]] && continue   # never carry admin across
            drush user:role:add "$r" "$name" >/dev/null 2>&1 || true
        done
    done < <(jq -c '.testers[]' "$TESTERS_CAPTURE" 2>/dev/null)

    local detail="restored=${updated} created=${created} collided=${collided} failed=${failed}"
    if [[ "$collided" -gt 0 || "$failed" -gt 0 ]]; then
        TESTERS_VERDICT="restore-degraded"; TESTERS_DETAIL="$detail"
        log "testers-restore-degraded" "$detail"
        echo "FAIL  tester restore incomplete (${detail}) — some testers must ask for a login again." >&2
        return 1
    fi
    log "testers-restored" "$detail"
    echo "OK  tester logins restored (${detail}) — chosen passwords carried across the wipe."
    # A CLEAN RESTORE DOES NOT ERASE A DIRTY EXPORT. The two legs write the same
    # variable, and a plain assignment here let a good restore overwrite the
    # export's `unlisted-accounts` / `registry-entries-refused` verdict — so a
    # run that had found an unapproved login reported itself fully preserved.
    # Failure verdicts are STICKY: only an export that reached `exported` may be
    # upgraded to `restored`.
    if [[ "$TESTERS_VERDICT" == "exported" ]]; then
        TESTERS_VERDICT="restored"; TESTERS_DETAIL="$detail"
    else
        TESTERS_DETAIL="${TESTERS_DETAIL} | restore: ${detail}"
        echo "WARN  the restore itself succeeded, but the export reported '${TESTERS_VERDICT}' — this run is NOT clean."
    fi
    return 0
}

################################################################################
# GUILD MEMBERSHIP PERSISTENCE (ops#376)
#
# The identity leg above answers "can they log in tomorrow". This one answers
# "and can they still reach what they were asked to test". Both are needed:
# a tester restored to the golden's guild set is a tester whose testing task
# quietly reverted overnight.
#
# THE READ IS THE SITE'S OWN COMMAND, not SQL against the Group tables. `drush
# nwc:tester-list --format=json` already returns, per fenced account, every
# membership as {group_id, type, label, seed_key, roles[]} — the same document
# `pl demo testers <site> list --json` renders. Reimplementing that as a join
# over group_relationship here would be a second answer to "what is this
# tester's membership", and a second answer is one that drifts.
#
# THE WRITE IS A DIFF, NOT A REPLAY. After the golden import the list is read
# ONCE more and only the memberships the golden did NOT bring back are applied.
# A blind replay would be up to 8 testers x 16 groups = 128 drush calls on a
# 3.9 GB box that also serves GitLab and four other live sites; the diff is
# typically zero or one. It is also more honest: `already=N` records what the
# golden itself provided, which is not the same fact as "we restored it".
#
# WHAT THIS LEG CANNOT DO, stated rather than hidden:
#   * interest groups. nwc:tester-set-guild addresses GUILD-type groups only —
#     measured live: its refusal names nine known seed keys and the seven
#     `*-ig` flexible_groups are not among them. IG memberships are counted as
#     `groups_unsupported` and named in the log, never silently dropped.
#   * more than one individual-scope role per membership — see
#     TESTERS_ROLE_PRECEDENCE above. Dropped extras are counted and named.
################################################################################

# testers_guild_rows <tester-list-json> <roster> — one TSV row per restorable
# membership: <account>\t<seed_key>\t<chosen-role|member>\t<dropped,roles>
#
# Filtering happens in ONE place (jq), against the roster the identity leg
# already validated, so an account this box may not touch cannot enter the
# capture by any route.
testers_guild_rows() {
    local listjson="$1" roster="$2"
    jq -r --arg names "$roster" --arg prec "$TESTERS_ROLE_PRECEDENCE" \
          --arg synth "$TESTERS_ROLE_SYNTHETIC" '
        ($names   | split("\n") | map(select(length>0))) as $roster |
        ($prec    | split(" ")) as $precedence |
        ($synth   | split(" ")) as $synthetic |
        .accounts[]?
        | select(.name as $n | $roster | index($n))
        | .name as $acct
        | .guilds[]?
        | select(.type == "guild")
        | . as $g
        # Individual-scope roles only: drop the roles group itself applies.
        | ([ $g.roles[]? | select(. as $r | ($synthetic | index($r)) | not) ]) as $indiv
        # Order by the declared precedence. A role we do not know is NOT
        # silently ignored — it sorts last and is reported as dropped, because
        # an unrecognised role is a fact about drift, not noise.
        | ([ $precedence[] | select(. as $p | $indiv | index($p)) ]
           + [ $indiv[] | select(. as $r | $precedence | index($r) | not) ]) as $ranked
        | [ $acct,
            $g.seed_key,
            ($ranked[0] // "member"),
            ($ranked[1:] | join(","))
          ] | @tsv
    ' <<<"$listjson" 2>/dev/null
}

# ---- PRE-WIPE MEMBERSHIP EXPORT ---------------------------------------------
# Fail-OPEN for the reset and for the IDENTITY leg (this must never be able to
# cost a tester their password), fail-LOUD for the report.
testers_guilds_export() {
    local roster="$1"

    if [[ -z "${roster//[[:space:]]/}" ]]; then
        GUILDS_VERDICT="no-testers"
        GUILDS_DETAIL="the roster names nobody, so there is no membership to carry"
        return 0
    fi

    local out rc=0
    out="$(drush "$TESTERS_LIST_CMD" --format=json 2>&1)" || rc=$?

    # An nwc too old to know the command is a NAMED gap with a real remedy, not
    # a silent skip: without it every tester's guilds revert every night and
    # nothing says so.
    if grep -q 'is not defined' <<<"$out"; then
        GUILDS_VERDICT="not-deployed"
        GUILDS_DETAIL="${TESTERS_LIST_CMD} is not on this site — deploy the nwc profile"
        log "testers-guilds-not-deployed" "cmd=${TESTERS_LIST_CMD}"
        echo "FAIL  ${TESTERS_LIST_CMD} is not deployed here — guild memberships CANNOT be captured and will revert to the golden." >&2
        return 1
    fi
    if (( rc != 0 )) || ! jq -e '.ok == true and (.accounts|type=="array")' <<<"$out" >/dev/null 2>&1; then
        GUILDS_VERDICT="export-failed"
        GUILDS_DETAIL="rc=${rc}; ${TESTERS_LIST_CMD} did not return a readable roster"
        log "testers-guilds-export-failed" "rc=${rc}"
        echo "FAIL  could not read guild memberships before the wipe — they are NOT preserved tonight." >&2
        return 1
    fi

    # Interest groups: counted and named, never silently discarded. This leg's
    # write API cannot address them, and an operator who is not told that will
    # believe it can.
    local ig_n ig_names
    ig_names="$(jq -r --arg names "$roster" '
        ($names | split("\n") | map(select(length>0))) as $roster |
        [ .accounts[]? | select(.name as $n | $roster | index($n))
          | .name as $a | .guilds[]? | select(.type != "guild")
          | "\($a):\(.seed_key)" ] | join(" ")' <<<"$out" 2>/dev/null)"
    ig_n="$(printf '%s' "$ig_names" | wc -w | tr -d ' ')"

    # A zero here is a GENUINE zero, and it is genuine because the command
    # reported ok:true above. That is why the capture goes through the site's
    # own read command rather than a heuristic: "nobody is in a guild" and "I
    # could not see who is in a guild" are told apart by the API saying which,
    # not by a listed>0/captured==0 rule of thumb like the identity leg needs
    # for its raw-SQL export.
    local rows n_cap n_dropped
    rows="$(testers_guild_rows "$out" "$roster")"
    if ! jq -Rn --arg utc "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" --arg rows "$rows" '
            {version:1, captured_utc:$utc,
             memberships: [ $rows | split("\n")[] | select(length>0) | split("\t")
                            | {account:.[0], seed_key:.[1], role:.[2],
                               dropped:(.[3] // "" | split(",") | map(select(length>0)))} ]}' \
            >"${TESTERS_GUILDS_CAPTURE}.new" 2>/dev/null; then
        GUILDS_VERDICT="export-failed"
        GUILDS_DETAIL="could not write the membership capture"
        log "testers-guilds-export-failed" "stage=write"
        echo "FAIL  could not write the guild membership capture — memberships are NOT preserved tonight." >&2
        return 1
    fi
    chmod 0600 "${TESTERS_GUILDS_CAPTURE}.new" 2>/dev/null || true
    mv -f "${TESTERS_GUILDS_CAPTURE}.new" "$TESTERS_GUILDS_CAPTURE" 2>/dev/null || {
        GUILDS_VERDICT="export-failed"
        GUILDS_DETAIL="could not commit the membership capture"
        log "testers-guilds-export-failed" "stage=rename"
        echo "FAIL  could not commit the guild membership capture — memberships are NOT preserved tonight." >&2
        return 1
    }

    n_cap="$(jq -r '.memberships | length' "$TESTERS_GUILDS_CAPTURE" 2>/dev/null || echo 0)"
    n_dropped="$(jq -r '[.memberships[].dropped[]] | length' "$TESTERS_GUILDS_CAPTURE" 2>/dev/null || echo 0)"
    GUILDS_VERDICT="captured"
    GUILDS_DETAIL="memberships_captured=${n_cap} dropped_roles=${n_dropped} groups_unsupported=${ig_n}"
    log "testers-guilds-exported" "$GUILDS_DETAIL"
    echo "OK  guild memberships captured: ${n_cap} (roles beyond one per membership: ${n_dropped})"
    if [[ "$n_dropped" -gt 0 ]]; then
        log "testers-guilds-dropped-roles" \
            "$(jq -r '[.memberships[] | select((.dropped|length)>0) | "\(.account):\(.seed_key):kept=\(.role):dropped=\(.dropped|join("+"))"] | join(" ")' "$TESTERS_GUILDS_CAPTURE" 2>/dev/null | cut -c1-400)"
        echo "..  ${n_dropped} extra role(s) cannot be carried — one individual-scope role per membership is all the write API takes."
        echo "..  Kept by precedence (${TESTERS_ROLE_PRECEDENCE% *}…); every dropped role is named in ${LOG_FILE}."
    fi
    if [[ "$ig_n" -gt 0 ]]; then
        log "testers-guilds-unsupported" "count=${ig_n} names=$(scrub "$ig_names")"
        echo "..  ${ig_n} interest-group membership(s) are outside this leg (nwc:tester-set-guild addresses guilds only): ${ig_names}"
    fi
    return 0
}

# ---- POST-IMPORT MEMBERSHIP RESTORE -----------------------------------------
testers_guilds_restore() {
    [[ -s "$TESTERS_GUILDS_CAPTURE" ]] || {
        log "testers-guilds-restore-skipped" "no capture to restore"
        return 0
    }
    jq -e '.version == 1 and (.memberships|type=="array")' "$TESTERS_GUILDS_CAPTURE" >/dev/null 2>&1 || {
        GUILDS_VERDICT="capture-malformed"
        GUILDS_DETAIL="the membership capture is unreadable"
        log "testers-guilds-restore-failed" "capture unreadable"
        echo "FAIL  the guild membership capture is unreadable — memberships were NOT restored." >&2
        return 1
    }

    local want; want="$(jq -r '.memberships | length' "$TESTERS_GUILDS_CAPTURE" 2>/dev/null || echo 0)"
    if [[ "$want" == "0" ]]; then
        GUILDS_VERDICT="restored"
        GUILDS_DETAIL="memberships_captured=0 memberships_present=0 memberships_restored=0 memberships_failed=0 dropped_roles=0"
        log "testers-guilds-restored" "$GUILDS_DETAIL"
        return 0
    fi

    # ONE post-import read: what did the golden already bring back?
    local now_out rc=0
    now_out="$(drush "$TESTERS_LIST_CMD" --format=json 2>&1)" || rc=$?
    if (( rc != 0 )) || ! jq -e '.ok == true and (.accounts|type=="array")' <<<"$now_out" >/dev/null 2>&1; then
        GUILDS_VERDICT="restore-blind"
        GUILDS_DETAIL="memberships_captured=${want}; could not re-read memberships after the import"
        log "testers-guilds-restore-blind" "rc=${rc} captured=${want}"
        echo "FAIL  could not re-read guild memberships after the restore — CANNOT VERIFY which were carried across." >&2
        return 1
    fi

    local present=0 restored=0 failed=0 acct key role dropped have failnames=""
    while IFS=$'\t' read -r acct key role dropped; do
        [[ -n "$acct" && -n "$key" ]] || continue
        # Already there, with the right individual role? Then the GOLDEN
        # provided it and this leg did nothing — recorded as `present`, never
        # claimed as `restored`. Claiming credit for the golden's work is how a
        # broken restore leg goes unnoticed for months.
        have="$(jq -r --arg a "$acct" --arg k "$key" --arg synth "$TESTERS_ROLE_SYNTHETIC" '
            ($synth | split(" ")) as $synthetic |
            [ .accounts[]? | select(.name == $a) | .guilds[]? | select(.seed_key == $k)
              | [ .roles[]? | select(. as $r | ($synthetic | index($r)) | not) ] ]
            | if length == 0 then "ABSENT" else (.[0] | if length == 0 then "member" else join(",") end) end
        ' <<<"$now_out" 2>/dev/null)" || have="ABSENT"
        if [[ "$have" != "ABSENT" && ",${have}," == *",${role},"* ]]; then
            present=$(( present + 1 )); continue
        fi

        local sg rcs=0
        sg="$(drush "$TESTERS_SETGUILD_CMD" "$acct" "$key" "--group-role=${role}" 2>&1)" || rcs=$?
        if (( rcs == 0 )) && jq -e '.ok == true' <<<"$sg" >/dev/null 2>&1; then
            restored=$(( restored + 1 ))
        else
            failed=$(( failed + 1 ))
            failnames+="${acct}:${key} "
            # The reason matters and it is usually the interesting one: a guild
            # the golden no longer has is refused BY THE API, which is exactly
            # the golden-precedence guarantee doing its job.
            log "testers-guilds-restore-failed" \
                "acct=${acct} key=${key} role=${role} rc=${rcs} reason=$(scrub "$(jq -r '.reason // "unparsed"' <<<"$sg" 2>/dev/null || echo unparsed)")"
        fi
    done < <(jq -r '.memberships[] | [.account, .seed_key, .role, (.dropped|join(","))] | @tsv' \
                 "$TESTERS_GUILDS_CAPTURE" 2>/dev/null)

    local n_dropped
    n_dropped="$(jq -r '[.memberships[].dropped[]] | length' "$TESTERS_GUILDS_CAPTURE" 2>/dev/null || echo 0)"
    local detail="memberships_captured=${want} memberships_present=${present} memberships_restored=${restored} memberships_failed=${failed} dropped_roles=${n_dropped}"

    if [[ "$failed" -gt 0 ]]; then
        GUILDS_VERDICT="restore-degraded"; GUILDS_DETAIL="$detail"
        log "testers-guilds-restore-degraded" "$detail names=$(scrub "$failnames")"
        echo "FAIL  guild membership restore incomplete (${detail}) — not restored: ${failnames}" >&2
        return 1
    fi
    # STICKY, exactly like the identity leg: only an export that reached
    # `captured` may be upgraded to `restored`. A clean restore must not erase
    # a capture that already reported a problem.
    if [[ "$GUILDS_VERDICT" == "captured" ]]; then
        GUILDS_VERDICT="restored"; GUILDS_DETAIL="$detail"
        log "testers-guilds-restored" "$detail"
        echo "OK  guild memberships carried across (${detail})."
    else
        GUILDS_DETAIL="${GUILDS_DETAIL} | restore: ${detail}"
        echo "WARN  the membership restore ran, but the capture reported '${GUILDS_VERDICT}' — this run is NOT clean."
    fi
    return 0
}

################################################################################
# Guards (run for dry-run too — a dry run is exactly "all guards, no wipe")
################################################################################

[[ -d "$SITE_ROOT" && -x "${SITE_ROOT}/vendor/bin/drush" ]] \
    || die "precheck-failed" "no drush at ${SITE_ROOT}/vendor/bin/drush"
[[ -d "$FILES_PARENT" ]] || die "precheck-failed" "no files parent at ${FILES_PARENT}"

golden_verify || die "reset-failed" "reason=golden-verify"
echo "OK  golden image verified (manifest site=${SITE} + sha256 x2)"

require_demo_mode || die "reset-failed" "reason=not-demo-mode"
echo "OK  site reports demo_mode=true"

# [G5] Idempotence. `nightly` is a no-op once today's reset has succeeded;
# `reset` overrides the daily stamp but not the minimum interval.
TODAY="$(mel_today)"
LAST_LINE="$(cat "$STAMP_FILE" 2>/dev/null || true)"
LAST_DATE="${LAST_LINE%% *}"
LAST_EPOCH="${LAST_LINE##* }"
[[ "$LAST_EPOCH" =~ ^[0-9]+$ ]] || LAST_EPOCH=0

if [[ "$ACTION" == "nightly" && "$LAST_DATE" == "$TODAY" ]]; then
    log "skip-already-reset" "date=${TODAY}"
    echo "OK  ${SITE} already reset today (${TODAY} ${TZ_MEL}) — nothing to do."
    exit 0
fi

SINCE=$(( $(date +%s) - LAST_EPOCH ))
if [[ "$ACTION" != "dry-run" && "$LAST_EPOCH" -gt 0 && "$SINCE" -lt "$MIN_INTERVAL" ]]; then
    log "skip-rate-limited" "since=${SINCE}s min=${MIN_INTERVAL}s"
    echo "OK  last reset was ${SINCE}s ago (minimum ${MIN_INTERVAL}s) — nothing to do."
    exit 0
fi

NEWEST="$(newest_session)"
if ! idle_ok "$NEWEST"; then
    log "skip-active" "window=${IDLE_WINDOW}s newest=${NEWEST:-query-failed}"
    echo "ACTIVE  session activity within $(( IDLE_WINDOW / 60 )) min (newest=${NEWEST:-query-failed}) — NOT resetting."
    exit 3
fi
echo "OK  idle for >= $(( IDLE_WINDOW / 60 )) min (newest=${NEWEST})"

################################################################################
# [G9] FATE MANIFEST — printed and logged BEFORE anything destructive runs.
#
# Every figure is read live off this box (du, drush, jq, stat). Nothing here is
# assumed: if a size cannot be read the field says "?" rather than a guess, so
# the manifest can never overstate how much is known.
#
# Two different things are deliberately NOT conflated:
#   * DEGRADED — a figure could not be read. The `|| true` / "?" discipline
#     throughout means this never fails; a partial manifest is still a manifest
#     and the reset proceeds.
#   * FAILED — the manifest could not be produced at all, or could not be
#     written to LOG_FILE. Then there is no record, and [G9] says a reset
#     without a record does not happen. The call site below enforces that.
################################################################################

_size_of() {   # human size of a path, or "?" — never fails
    du -sh "$1" 2>/dev/null | awk '{print $1}' || true
}

render_fate_manifest() {
    local db_bytes db_size files_size code_count golden_captured
    db_bytes="$(drush sqlq "SELECT COALESCE(SUM(data_length+index_length),0) FROM information_schema.TABLES WHERE table_schema=DATABASE()" 2>/dev/null | tr -dc '0-9')"
    if [[ -n "$db_bytes" ]]; then
        db_size="$(numfmt --to=iec --suffix=B "$db_bytes" 2>/dev/null || echo "${db_bytes}B")"
    else
        db_size="?"
    fi
    files_size="$(_size_of "${FILES_PARENT}/files")"
    golden_captured="$(jq -r '.captured_utc // "?"' "${GOLDEN_DIR}/golden.manifest.json" 2>/dev/null || echo '?')"
    if [[ -s "$CODES_PAYLOAD" ]]; then
        code_count="$(jq -r '.codes | length' "$CODES_PAYLOAD" 2>/dev/null || echo '?')"
    else
        code_count="not-staged"
    fi

    echo ""
    echo "FATE MANIFEST — ${SITE} (${DOMAIN}) demo reset, action=${ACTION}"
    echo "  source of truth: golden image ${GOLDEN_DIR} (captured ${golden_captured}, sha256 verified)"
    echo ""
    echo "WILL BE PERMANENTLY DELETED:"
    echo "    Uploads:    ${FILES_PARENT}/files (${files_size:-?}) — removed, then replaced from golden."
    echo "                Anything a tester uploaded since the last reset is GONE; there is no copy."
    echo "    Watchdog:   the dblog table — a digest is harvested to ${HARVEST_DIR} first (best effort)."
    echo ""
    echo "WILL BE OVERWRITTEN:"
    echo "    Database:   ${SITE} (${db_size}) — dropped and reloaded from ${GOLDEN_DB}."
    echo "                All demo accounts, content and sessions revert to the golden state."
    echo "    Demo users: reseeded by 'drush nwc:seed-demo'."
    echo "    Invite codes: staged payload holds ${code_count} code(s) — the staged payload is"
    echo "                AUTHORITATIVE and replaces whatever the site currently has."
    echo ""
    echo "NOT AFFECTED:"
    echo "    • the golden image itself (read-only here; a failed restore leaves it intact)"
    echo "    • every other site on this box — SITE_ROOT is hard-wired to ${SITE_ROOT} [G2]"
    echo "      and the live site was re-checked to report demo_mode=true"
    echo "    • plaintext invite codes — only hashes ever exist on this box"
    echo "    • ${LOG_FILE} and the harvest digests"
    echo ""

    # Last statement on purpose: "printed AND logged" means this function is
    # only successful if the line actually landed in LOG_FILE.
    log "fate-manifest" "action=${ACTION} db=${db_size} files=${files_size:-?} codes=${code_count} golden=${golden_captured}" \
        || return 1
}

# [G9] enforcement. The manifest is the licence to destroy, so a real reset that
# has not got one stops here rather than proceeding to wipe with the failure
# merely noted. A dry-run keeps the old fail-open behaviour: nothing destructive
# follows it, so aborting would remove an operator's only way to look without
# protecting anything.
if ! render_fate_manifest; then
    if [[ "$ACTION" == "dry-run" ]]; then
        log "fate-manifest-failed" "dry-run — nothing destructive follows, continuing"
    else
        die "fate-manifest-failed" \
            "refusing to destroy anything without a printed+logged manifest [G9]" 1
    fi
fi

if [[ "$ACTION" == "dry-run" ]]; then
    log "dry-run-ok" "all guards passed; nothing changed"
    echo "OK  DRY RUN — all guards passed and the manifest above is what a real run would do."
    echo "OK  Nothing was changed."
    exit 0
fi

################################################################################
# Destructive section
################################################################################

START="$(date +%s)"

# Pre-wipe error harvest (fail-OPEN — must never block the reset). The restore
# destroys watchdog, so the digest has to be taken first.
harvest() {
    mkdir -p "$HARVEST_DIR" 2>/dev/null || return 0
    local out="${HARVEST_DIR}/harvest-$(date -u '+%Y%m%d-%H%M%S').txt"
    {
        drush watchdog:show --severity=Error    --count=100 --format=table 2>/dev/null
        drush watchdog:show --severity=Critical --count=100 --format=table 2>/dev/null
    } > "$out" 2>/dev/null || true
    if [[ -s "$out" ]]; then
        log "harvest" "file=$(basename "$out") bytes=$(stat -c%s "$out" 2>/dev/null || echo 0)"
    else
        rm -f "$out" 2>/dev/null || true
    fi
    # Keep the last 30 digests; the box is small.
    ls -1t "${HARVEST_DIR}"/harvest-*.txt 2>/dev/null | tail -n +31 | xargs -r rm -f
    return 0
}
harvest || true

# Pre-wipe TESTER IDENTITY export (ops#369). Fail-OPEN like the harvest: a
# broken export must never leave the demo site down. It is NOT silent — the
# verdict lands in TESTERS_VERDICT and the exit-status block below refuses to
# stamp the run clean unless the identities were actually carried across.
#
# ORDER IS LOAD-BEARING: this reads the LIVE database, so it has to happen
# before the database is dropped — the password a tester set exists nowhere
# else, and seconds later it is gone.
testers_export || true

# Pre-wipe GUILD MEMBERSHIP export (ops#376). Sequenced immediately after the
# identity export and, like it, fail-OPEN: `|| true` here is the partial-
# degradation requirement in one character — a membership leg that failed must
# not be able to abandon the identity leg that succeeded, nor stop the reset.
# It reads the same live database, so it too must run before the drop.
testers_guilds_export "$TESTERS_ROSTER" || true

# Pre-wipe TESTER-FEEDBACK notice (fail-OPEN — nwp/ops#161, closable ops#315).
#
# The harvest above keeps the errors nobody reported. The reports testers DID
# file are Feedback entities in the database the next block replaces. The
# `feedback-sync` action word above is the leg that pushes them — `pl demo
# nightly --via-key` invokes it BEFORE the reset — but this reset path does
# not assume that happened: a raw-ssh cron, a hand-run `reset`, or a
# feedback-sync that could not run (no token yet: exit 2 CANNOT VERIFY) all
# arrive here with the pending set intact.
#
# So the one honest thing this path does is refuse to destroy them SILENTLY.
# It counts what is about to go, logs it, and names the words that recover it.
# The count is a read-only --dry-run of the module's own sync command: no
# token, no network call, and any failure is swallowed.
#
# (Until ops#315 this was a KNOWN GAP — the wrapper held no token at all. The
# gap now closes the moment the operator stages TOKEN_FILE; this notice stays
# because a fail-open pre-leg can always have failed.)
feedback_pending() {
    local out
    out="$( cd "$SITE_ROOT" \
            && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" nwc-feedback:sync-to-gitlab \
                 --dry-run --limit=100 2>/dev/null )" || return 0
    [[ -n "$out" ]] || return 0
    case "$out" in
        *"No feedback items pending GitLab sync"*)
            log "feedback-none-pending" "nothing to lose"
            return 0 ;;
    esac
    local n
    n="$(printf '%s\n' "$out" | grep -c '\[DRY\] feedback #' 2>/dev/null)" || n="?"
    log "feedback-pending-unsynced" "count=${n} (DESTROYED by this reset — the feedback-sync leg did not run)"
    echo "WARN  ${n} tester feedback report(s) are pending GitLab sync and this reset DESTROYS them."
    echo "WARN  The pre-wipe leg did not run (or could not). Recover before the next reset with either:"
    echo "WARN      ssh -i ~/.ssh/${SITE}_demo_reset gitlab@<box> feedback-sync   (the box's own word)"
    echo "WARN      pl demo feedback-sync ${SITE} --tier=live                     (from an admin host)"
    return 0
}
feedback_pending || true

echo "..  restoring database from golden"
if ! ( cd "$SITE_ROOT" \
        && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" sql:drop -y >/dev/null 2>&1 \
        && gunzip -c "${GOLDEN_DIR}/${GOLDEN_DB}" | "${DRUSH_SUDO[@]}" "$DRUSH_BIN" sql:cli ); then
    die "reset-failed" "reason=import-db (golden intact at ${GOLDEN_DIR} — restore by hand)"
fi

echo "..  restoring files from golden"
if ! ( "${ROOT_SUDO[@]}" rm -rf "${FILES_PARENT}/files" \
        && "${ROOT_SUDO[@]}" tar xzf "${GOLDEN_DIR}/${GOLDEN_FILES}" -C "$FILES_PARENT" \
        && "${ROOT_SUDO[@]}" chown -R www-data:www-data "${FILES_PARENT}/files" ); then
    die "reset-failed" "reason=files-untar"
fi

echo "..  reseeding demo accounts (drush nwc:seed-demo)"
if ! drush nwc:seed-demo >/dev/null 2>&1; then
    die "reset-failed" "reason=seed-demo"
fi

# Re-push the hashed invite-code registry, if one has been staged. Hashes only
# — the plaintext codes never exist on this box. Non-fatal: without it the
# codes simply revert to whatever the golden snapshot held.
if [[ -s "$CODES_PAYLOAD" ]]; then
    CODE_COUNT="$(jq -r '.codes | length' "$CODES_PAYLOAD" 2>/dev/null || echo '?')"
    if drush state:set nwc_demo_access.codes "$(cat "$CODES_PAYLOAD")" >/dev/null 2>&1; then
        log "codes-synced" "count=${CODE_COUNT} staged=$(date -u -r "$CODES_PAYLOAD" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo '?')"
        # The staged payload is authoritative — same contract as the laptop's
        # `pl demo reset --tier=live`. An empty payload therefore CLEARS every
        # invite code, so it must be re-staged after any `pl demo codes|invite`
        # (install-box.sh --stage-codes). Loud, because it locks testers out.
        [[ "$CODE_COUNT" == "0" ]] && echo "WARN  staged code payload is EMPTY — all invite codes are now cleared. Re-stage with install-box.sh --stage-codes."
    else
        log "codes-sync-failed" "non-fatal"
    fi
else
    log "codes-not-staged" "codes revert to the golden snapshot"
fi

# Post-import TESTER IDENTITY restore (ops#369). AFTER the golden import and
# AFTER nwc:seed-demo — seed-demo reasserts the persona/matrix accounts, so
# restoring first would let it overwrite a tester's chosen password with the
# seed's. Before `drush cr`, so the caches are rebuilt over the restored users
# rather than over the golden's.
testers_restore || true

# Post-import GUILD MEMBERSHIP restore (ops#376). AFTER testers_restore, which
# is not an ordering preference: nwc:tester-set-guild joins an ACCOUNT to a
# guild, so the account has to exist first. A tester the identity leg could not
# restore therefore simply has no membership row to apply, and the API's own
# "no such account" refusal counts as a named failure rather than a crash.
testers_guilds_restore || true

drush cr >/dev/null 2>&1 || log "cr-failed" "non-fatal"

# Declared BEFORE the first thing that can set it: [G10] below and the smoke
# check both degrade the run, and re-initialising it between them would erase
# whichever spoke first.
DEGRADED=false

# [G10] Post-restore pending-update detection (ops#226). A golden captured
# while an update was pending restores a permanently-pending site: the schema
# comes back pre-update every night and nothing here runs updatedb. Capture now
# refuses that, but older goldens predate the guard, so a reset that puts one
# back must SAY so rather than report reset-ok.
#
# Fail-closed on the read, not on the site: a probe we cannot read is degraded,
# not fatal — the data is already restored and the operator needs the report.
# Clean sites print nothing on stdout, hence the marker.
PENDING_JSON="$(drush updatedb:status --format=json 2>/dev/null && echo "$PENDING_MARKER")"
if ! printf '%s\n' "$PENDING_JSON" | grep -qx "$PENDING_MARKER"; then
    DEGRADED=true
    log "reset-pending-updates" "state=unreadable"
    echo "FAIL  could not read the site's update state after the restore — treat the golden as unverified."
else
    PENDING_PAYLOAD="$(printf '%s\n' "$PENDING_JSON" | grep -vx "$PENDING_MARKER" | sed '/^[[:space:]]*$/d')"
    if [[ -n "$PENDING_PAYLOAD" ]]; then
        PENDING_N="$(printf '%s' "$PENDING_PAYLOAD" | jq -r 'length' 2>/dev/null || echo '?')"
        if [[ "$PENDING_N" != "0" ]]; then
            DEGRADED=true
            log "reset-pending-updates" "pending=${PENDING_N} golden_attests=$(jq -r '.pending_db_updates // "unknown"' "${GOLDEN_DIR}/golden.manifest.json" 2>/dev/null || echo unknown)"
            echo "FAIL  ${PENDING_N} database update(s) are PENDING after the restore."
            printf '%s' "$PENDING_PAYLOAD" | jq -r 'if type=="object" then keys_unsorted[] else (.[]|tostring) end' 2>/dev/null | head -10 | sed 's/^/      /'
            echo "      The golden itself carries them, so running updatedb here is undone at the next reset."
            echo "      Fix: run the updates, then re-capture the golden (pl demo golden nwd --tier=live)."
        fi
    fi
fi

# Post-restore smoke, retried: the first request after a cache rebuild is a
# cold full render and on this small shared host that can 5xx once before the
# caches warm. Persistent failure is real and degrades the exit status.
CODE=""
for _ in $(seq 1 "$SMOKE_ATTEMPTS"); do
    CODE="$(curl -s -o /dev/null -w '%{http_code}' --max-time 45 "https://${DOMAIN}/" 2>/dev/null || echo 000)"
    [[ "$CODE" == "200" ]] && break
    sleep "$SMOKE_SLEEP"
done
if [[ "$CODE" == "200" ]]; then
    JCODE="$(curl -s -o /dev/null -w '%{http_code}' --max-time 45 "https://${DOMAIN}/demo/join" 2>/dev/null || echo 000)"
    if [[ "$JCODE" == "200" ]]; then
        echo "OK  https://${DOMAIN}/ and /demo/join both serve 200"
    else
        DEGRADED=true
        log "reset-degraded" "join_http=${JCODE}"
        echo "FAIL  /demo/join returned ${JCODE} — testers cannot join."
    fi
else
    DEGRADED=true
    log "reset-degraded" "http=${CODE} attempts=${SMOKE_ATTEMPTS}"
    echo "FAIL  https://${DOMAIN}/ still ${CODE} after ${SMOKE_ATTEMPTS} attempts."
fi

# ops#369 — TESTERS WERE NOT PRESERVED is a DEGRADATION, not a footnote.
#
# The reset itself succeeded: the site is up, the golden is back, the demo
# works. What failed is the promise that a tester can come back tomorrow with
# the password they chose. Silence there is the worst outcome available — a
# tester who believes they are preserved and is not — so it degrades the run
# exactly like a failed smoke check, and `status` carries the verdict forward
# so `pl demo status` / `seal-status` can say "testers were not preserved last
# night" instead of nothing.
case "$TESTERS_VERDICT" in
    restored|not-staged) ;;   # preserved, or nothing was ever declared to preserve
    exported)
        # Exported but never restored: the restore leg did not reach its own
        # verdict, which means it did not run. Never let that read as success.
        DEGRADED=true
        log "testers-not-restored" "export ran, restore did not — logins were NOT carried across"
        echo "FAIL  tester identities were captured but NOT restored — logins did not survive this reset." ;;
    *)
        DEGRADED=true
        log "testers-degraded" "verdict=${TESTERS_VERDICT} ${TESTERS_DETAIL}"
        echo "FAIL  tester identity preservation FAILED (${TESTERS_VERDICT}${TESTERS_DETAIL:+: ${TESTERS_DETAIL}})."
        echo "      Testers named by the registry may have to ask for a login again." ;;
esac
# ops#376 — THE MEMBERSHIP HALF, GRADED SEPARATELY. Partial degradation is the
# whole requirement: a run that carried every login across but lost a guild is
# neither a clean run nor a lost-logins run, and reporting it as either would
# send the operator to the wrong remedy. So it has its own case block, its own
# verdict file and its own `status` line, and it degrades the run on its own.
case "$GUILDS_VERDICT" in
    restored|no-testers|not-run) ;;   # carried, nothing to carry, or the leg never reached (a failed reset)
    captured)
        # Captured and never restored: the restore leg did not reach its own
        # verdict, i.e. it did not run. Same shape as the identity leg's
        # `exported`, and it must never read as success either.
        DEGRADED=true
        log "testers-guilds-not-restored" "capture ran, restore did not — memberships were NOT carried across"
        echo "FAIL  guild memberships were captured but NOT restored — testers are back in the golden's guilds only." ;;
    *)
        DEGRADED=true
        log "testers-guilds-degraded" "verdict=${GUILDS_VERDICT} ${GUILDS_DETAIL}"
        echo "FAIL  guild membership preservation FAILED (${GUILDS_VERDICT}${GUILDS_DETAIL:+: ${GUILDS_DETAIL}})."
        echo "      The LOGINS are unaffected — check the identity verdict above; this is the membership half only." ;;
esac

# The verdicts are persisted separately from the reset stamp so `status` can
# report them even when the run failed for an unrelated reason — and separately
# from EACH OTHER so neither can overwrite the other's answer.
{ printf '%s|%s|%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$TESTERS_VERDICT" "$TESTERS_DETAIL" \
    > "${TESTERS_DIR}/last-verdict" ; } 2>/dev/null || true
{ printf '%s|%s|%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$GUILDS_VERDICT" "$GUILDS_DETAIL" \
    > "${TESTERS_DIR}/last-guilds" ; } 2>/dev/null || true

TOOK=$(( $(date +%s) - START ))

if [[ "$DEGRADED" == "true" ]]; then
    log "reset-ok-degraded" "took=${TOOK}s"
    echo "WARN  data restored but the site failed its smoke check — treat as FAILED."
    exit 1
fi

# Stamp only a fully clean reset [G5].
mkdir -p "$STATE_DIR" 2>/dev/null || true
printf '%s %s\n' "$TODAY" "$(date +%s)" > "$STAMP_FILE"
log "reset-ok" "took=${TOOK}s action=${ACTION}"
echo "OK  nwd demo reset complete in ${TOOK}s — back at the golden image."
exit 0
