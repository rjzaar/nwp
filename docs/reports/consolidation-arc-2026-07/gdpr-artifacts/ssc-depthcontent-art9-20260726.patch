+}}
+{{!
+    @template mod_depthcontent/feedback_modal
+
+    Body of the S13 feedback modal. Renders one of two variants:
+    Level A (candidates) or Level B (basic thumbs + verdict). The caller
+    supplies exactly one of `candidates` or `basic`; the other is null/absent.
+
+    Context variables:
+    * fb_state_id - int - Feedback state id.
+    * status - string - "candidates" | "open" | "locked".
+    * candidates - array|null - Candidate rows (Level A).
+        Each: { idx, vote_key, title, video_url, notes, slot_fit }
+    * basic - object|null - Basic view (Level B).
+        { current_title, current_video_url }
+
+    Example context (json):
+    {
+        "fb_state_id": 42,
+        "status": "candidates",
+        "candidates": [
+            {"idx": 0, "vote_key": "ep645_416", "title": "Fr Mike #645 @ 6:56",
+             "video_url": "https://youtube.com/x", "notes": "Strong (A,B,D); weak (C)", "slot_fit": "0.78"},
+            {"idx": 1, "vote_key": "ep492_1056", "title": "Fr Mike #492 @ 17:36",
+             "video_url": "https://youtube.com/y", "notes": "Strong (all four)", "slot_fit": "0.81"}
+        ],
+        "basic": null
+    }
+}}
+<div class="depthcontent-feedback-modal" data-fb-state-id="{{fb_state_id}}">
+
+    {{#candidates}}
+    <div class="depthcontent-feedback-candidate">
+        <div class="depthcontent-feedback-candidate-title">{{title}}</div>
+        {{#video_url}}
+        <a class="depthcontent-feedback-candidate-play btn btn-sm btn-outline-primary"
+           href="{{video_url}}" target="_blank" rel="noopener">
+            {{#str}}feedback:play, mod_depthcontent{{/str}}
+        </a>
+        {{/video_url}}
+        {{#notes}}
+        <div class="depthcontent-feedback-candidate-notes text-muted">{{notes}}</div>
+        {{/notes}}
+        {{#slot_fit}}
+        <div class="depthcontent-feedback-candidate-score text-muted">slot_fit: {{slot_fit}}</div>
+        {{/slot_fit}}
+        <label class="depthcontent-feedback-candidate-pick">
+            <input type="radio" name="dc-fb-candidate" value="{{vote_key}}">
+            {{#str}}feedback:pick_one, mod_depthcontent{{/str}}
+        </label>
+    </div>
+    {{/candidates}}
+
+    {{#candidates}}
+    {{^idx}}
+    <div class="depthcontent-feedback-why-wrap">
+        <label>
+            {{#str}}feedback:why_optional, mod_depthcontent{{/str}}
+            <textarea class="dc-fb-why form-control" rows="2"></textarea>
+        </label>
+    </div>
+    {{/idx}}
+    {{/candidates}}
+
+    {{#basic}}
+    <div class="depthcontent-feedback-basic">
+        <div class="depthcontent-feedback-basic-head">
+            <strong>{{current_title}}</strong>
+            {{#current_video_url}}
+            <a class="depthcontent-feedback-basic-play btn btn-sm btn-outline-primary"
+               href="{{current_video_url}}" target="_blank" rel="noopener">
+                {{#str}}feedback:play, mod_depthcontent{{/str}}
+            </a>
+            {{/current_video_url}}
+        </div>
+
+        <fieldset class="depthcontent-feedback-thumbs">
+            <legend class="sr-only">Thumbs</legend>
+            <label>
+                <input type="radio" name="dc-fb-thumbs" value="up">
+                {{#str}}feedback:thumbs_up, mod_depthcontent{{/str}}
+            </label>
+            <label>
+                <input type="radio" name="dc-fb-thumbs" value="down">
+                {{#str}}feedback:thumbs_down, mod_depthcontent{{/str}}
+            </label>
+        </fieldset>
+
+        <fieldset class="depthcontent-feedback-verdict">
+            <legend>{{#str}}feedback:teaches_question, mod_depthcontent{{/str}}</legend>
+            <label>
+                <input type="radio" name="dc-fb-verdict" value="yes">
+                {{#str}}feedback:teaches_yes, mod_depthcontent{{/str}}
+            </label>
+            <label>
+                <input type="radio" name="dc-fb-verdict" value="partially">
+                {{#str}}feedback:teaches_partially, mod_depthcontent{{/str}}
+            </label>
+            <label>
+                <input type="radio" name="dc-fb-verdict" value="no">
+                {{#str}}feedback:teaches_no, mod_depthcontent{{/str}}
+            </label>
+        </fieldset>
+
+        <div class="depthcontent-feedback-why-wrap">
+            <label>
+                {{#str}}feedback:why_optional, mod_depthcontent{{/str}}
+                <textarea class="dc-fb-why form-control" rows="2"></textarea>
+            </label>
+        </div>
+    </div>
+    {{/basic}}
+
+</div>
