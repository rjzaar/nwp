#!/bin/bash
################################################################################
# /usr/local/bin/nwd-demo-reset-restricted — forced-command demo reset (ops#133)
#
# Installed on the git.nwpcode.org box as the SSH forced command for the
# dedicated `nwd-demo-reset@met` key:
#
#   command="/usr/local/bin/nwd-demo-reset-restricted",no-agent-forwarding,
#   no-port-forwarding,no-pty,no-user-rc,no-X11-forwarding ssh-ed25519 AAAA…
#
# WHY THIS EXISTS
#   `pl demo reset nwd --tier=live` orchestrates the nightly demo wipe over ssh
#   as `gitlab@`, and `gitlab@` on this box has NOPASSWD sudo — i.e. root on the
#   host that runs GitLab plus five live sites. Handing met a plain `gitlab@`
#   key would hand met root. Standing rule: never. Instead met gets a key that
#   can invoke exactly ONE program — this one — which performs the nwd demo
#   reset locally and nothing else.
#
# GUARANTEES (each enforced below, marked [Gn])
#   [G1] The client's command line is NEVER executed. $SSH_ORIGINAL_COMMAND is
#        logged verbatim and then matched against a fixed literal allowlist of
#        action words. Anything outside the allowlist is refused (exit 2). No
#        eval, no `sh -c`, no expansion of client data into any command.
#   [G2] The target is hard-wired to nwd. SITE/paths are constants; there is no
#        way to name another site. Before anything destructive the script also
#        re-checks that the live site reports nwc_demo_access demo_mode = true,
#        so even a mis-pointed SITE_ROOT cannot wipe a non-demo site.
#   [G3] Fail-closed on the golden image: manifest must name nwd and BOTH
#        artifacts must pass sha256 before a single byte is dropped.
#   [G4] Idle guard: a session newer than IDLE_WINDOW (or a failed/garbled
#        sessions query) counts as ACTIVE and exits 3 (retryable), never wipes.
#   [G5] Idempotent: one successful reset per Melbourne day (stamp file), plus a
#        hard minimum interval between resets — repeat invocations are cheap
#        no-ops, so met's cron can simply retry every 30 min.
#   [G6] Single-flight: flock, so overlapping invocations cannot interleave.
#   [G7] Every invocation (accepted or refused) appends one line to LOG_FILE.
#   [G8] Non-zero exit on failure; 3 = "active, retry"; 0 = reset done/no-op.
#   [G10] PENDING-UPDATE DETECTION (ops#226). After the restore the site is
#        asked whether it still owes a hook_update_N. A golden captured while
#        an update was pending re-pends it every single night — the restore
#        returns the pre-update schema and this script never runs updatedb —
#        so the condition is permanent and invisible. `pl demo golden` now
#        REFUSES such a capture, but goldens taken before that guard existed
#        are still out there, so the reset says so instead of reporting
#        reset-ok: pending updates (or an unreadable update state) degrade the
#        run exactly like a failed smoke check.
#   [G9] FATE MANIFEST (ops#47 impact contract, ops#143). Nothing destructive
#        runs until the manifest below has been printed AND logged, naming every
#        component and its fate with sizes read live off this box. This is
#        ENFORCED, not attempted: if the manifest cannot be rendered, or cannot
#        be persisted to LOG_FILE, a real reset ABORTS (exit 1) and destroys
#        nothing — because a reset with no surviving record of what it destroyed
#        is exactly the thing this guarantee exists to prevent. Degradation is
#        not failure: any figure that cannot be read prints "?" and the manifest
#        still stands, so only a total rendering/logging failure aborts.
#        `dry-run` prints exactly the same manifest and stops — so a dry run is
#        a truthful preview, not a different code path — and a dry run whose
#        manifest fails still exits 0, since nothing destructive follows it and
#        failing closed there would only take away an operator's ability to
#        look. There is no prompt here (the caller is met's cron over a forced
#        command, never a human at a TTY), so the manifest is the whole of the
#        contract: `-y` skips the PROMPT, never the REPORT, and here there is
#        only report.
#
# impact-contract: inline
#   This script is DEPLOYED TO A BOX WITH NO REPO CHECKOUT, so it cannot source
#   lib/impact.sh. It therefore renders the manifest itself; the pragma above is
#   what tells tests/unit/test-impact-contract.bats to expect an inline
#   `FATE MANIFEST` block rather than a source of the lib. The pragma ALONE does
#   not satisfy the gate — the manifest has to actually be there.
#
# NOT GUARANTEED (honest gaps — see docs/guides/demo-nightly-on-met.md §Gaps)
#   * The script runs AS `gitlab`, which has NOPASSWD sudo, and it uses sudo for
#     the www-data drush calls and the files restore. The containment is that
#     met can only *invoke* this script, not choose what it does — not that the
#     script is itself unprivileged. A dedicated unix account + a narrow
#     sudoers rule would remove that residue; recorded as follow-up.
#   * [G9]'s abort adds a way for the nightly to become a no-op: if LOG_FILE
#     stops being writable, every run refuses. That is the intended direction
#     (no record → no destruction), and it is visible: the refusal still prints
#     to stdout/stderr and exits 1, which met's cron captures in
#     ~/logs/demo-nightly-nwd.log, and the 30-min retry window means an operator
#     sees seven identical failures rather than one. It is NOT self-healing —
#     `status` (which never aborts) is the way to look.
#
# THE TWO NON-RESET LEGS (ops#315 — the box completes its own nightly)
#   feedback-sync   push pending tester Feedback entities to GitLab through the
#                   module's OWN drush command, before the reset destroys them.
#                   The ops#140 minimisation interlock is preserved FAIL-CLOSED
#                   on this side of the wire: unless the deployed nwc_feedback
#                   provably carries buildIssueDescription, nothing leaves.
#   harvest-post    post the spooled pre-wipe error digests to nwp/ops issues,
#                   from the box's own spool, then move them to posted/ so the
#                   `harvest` drain and this word never double-report.
#   Both authenticate with ONE walled api token read from TOKEN_FILE — a
#   root-owned 0600 file this wrapper NEVER creates, prints or logs
#   (provisioning is an operator step; see the registry entry
#   demo_box_feedback_token and install-box.sh's report). A missing token is
#   exit 2 CANNOT VERIFY — a leg that could not run and says so — never a
#   silent skip. This is the pattern the box already lives: local_feedback's
#   own gitlab_token posts issues at submit time today, so a walled
#   issue-write token on this host is established practice, not a widening.
#   The KEY still gains nothing but named words: [G1] is unchanged, and the
#   scheduler that holds the key remains a dumb clock.
#
# Exit codes: 0 ok/no-op · 1 failure (incl. [G9] no-manifest abort) ·
#             2 refused (bad action word) or CANNOT VERIFY (feedback-sync/
#               harvest-post with no readable token) · 3 active
################################################################################

set -uo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
IFS=$' \t\n'
umask 022

# ---- Hard-wired target [G2] -------------------------------------------------
SITE="nwd"
SITE_ROOT="/var/www/nwd"
DOCROOT="html"
FILES_PARENT="${SITE_ROOT}/${DOCROOT}/sites/default"
DOMAIN="nwd.nwpcode.org"
STATE_DIR="/var/lib/nwp-demo/${SITE}"
GOLDEN_DIR="${STATE_DIR}/golden"
GOLDEN_DB="golden.db.sql.gz"
GOLDEN_FILES="golden.files.tar.gz"
CODES_PAYLOAD="${STATE_DIR}/codes-payload.json"
STAMP_FILE="${STATE_DIR}/last-reset"
HARVEST_DIR="${STATE_DIR}/harvest"
LOCK_FILE="/var/lock/nwd-demo-reset.lock"
LOG_FILE="/var/log/nwp-demo/nwd-demo-reset.log"

# ---- ops#315: the box's own GitLab legs ------------------------------------
# TOKEN_FILE holds the ONE walled api token (issue-write to the feedback + ops
# projects only — see private/secrets-registry.yml: demo_box_feedback_token).
# Root-owned 0600, written by the OPERATOR via pl secrets, never by this file
# and never by install-box.sh.
TOKEN_FILE="/etc/nwp-demo/feedback.token"
GITLAB_API="https://git.nwpcode.org/api/v4"
OPS_PROJECT_ID=21                     # nwp/ops — where harvest digests are filed
HARVEST_LABELS="demo-tester,auto-harvest"   # matches scripts/commands/demo.sh
# The module's own sync command + sentinels, byte-identical to lib/demo.sh
# (DEMO_FEEDBACK_*): one renderer, one probe, two hosts.
FEEDBACK_SYNC_CMD="nwc-feedback:sync-to-gitlab"
FEEDBACK_LIMIT=100
FEEDBACK_NONE_MARKER="No feedback items pending GitLab sync"
FEEDBACK_MIN_PROBE='echo method_exists(\Drupal::service("nwc_feedback.gitlab_sync"), "buildIssueDescription") ? "MINIMISED-OK" : "MINIMISATION-MISSING";'

DRUSH_SUDO=(sudo -u www-data)
DRUSH_BIN="./vendor/bin/drush"
ROOT_SUDO=(sudo)

TZ_MEL="Australia/Melbourne"
IDLE_WINDOW=1800        # 30 min — matches `pl demo reset --if-idle 30m`
MIN_INTERVAL=600        # 10 min hard floor between two real resets [G5]
SMOKE_ATTEMPTS=5
SMOKE_SLEEP=5
# [G10] Completion marker for the pending-update probe. A clean site prints
# NOTHING on stdout (drush puts "No database updates required" on stderr), so
# emptiness alone cannot tell "no updates" from "the probe never ran".
PENDING_MARKER='PENDING_UPDATES_PROBE_OK'

################################################################################
# Logging [G7]
################################################################################

log() {
    local event="$1" detail="${2:-}"
    local line rc=0
    line="$(date -u '+%Y-%m-%dT%H:%M:%SZ')|${event}|${detail}"
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    # The redirection itself is what can fail (unwritable log dir), so it is
    # wrapped — `>> f 2>/dev/null` would still print the shell's own error.
    { printf '%s\n' "$line" >> "$LOG_FILE"; } 2>/dev/null || rc=1
    printf '%s\n' "$line"
    # log() is still fail-SOFT for control flow — no caller is obliged to check,
    # nothing aborts merely because the log dir broke, and `status` keeps
    # answering. But it is now HONEST: the return code says whether the line was
    # actually PERSISTED, which is the one thing [G9] has to be able to ask.
    # Every other call site uses `log` in statement position, and this script
    # does not run under `set -e`, so a non-zero return changes nothing there.
    return "$rc"
}

die() { log "$1" "${2:-}"; echo "ERROR: ${1} ${2:-}" >&2; exit "${3:-1}"; }

# Sanitise a string for a single log field: strip newlines/pipes, cap length.
# The client controls $SSH_ORIGINAL_COMMAND, so it is scrubbed before it is
# written and is never used for anything else. [G1]
scrub() {
    printf '%s' "$1" | tr -d '\000-\037' | tr '|' '/' | cut -c1-200
}

################################################################################
# [G1] Action word: fixed literal allowlist, never executed as a command
################################################################################

RAW_CMD="${SSH_ORIGINAL_COMMAND:-}"
CLIENT="${SSH_CLIENT:-local}"

resolve_action() {
    # Only these exact strings are honoured. Note the case arms are literals —
    # $RAW_CMD is compared, never expanded into a command position.
    case "$RAW_CMD" in
        ""|nightly)    echo "nightly" ;;
        reset)         echo "reset" ;;
        dry-run)       echo "dry-run" ;;
        status)        echo "status" ;;
        harvest)       echo "harvest" ;;
        feedback-sync) echo "feedback-sync" ;;
        harvest-post)  echo "harvest-post" ;;
        *)             echo "REFUSED" ;;
    esac
}

ACTION="$(resolve_action)"

if [[ "$ACTION" == "REFUSED" ]]; then
    log "rejected-command" "client=${CLIENT%% *} requested=$(scrub "$RAW_CMD")"
    cat >&2 <<EOF
REFUSED: this key may only run the nwd demo reset.
The command you sent was logged and NOT executed.
Allowed action words: (empty)|nightly | reset | dry-run | status | harvest | feedback-sync | harvest-post
EOF
    exit 2
fi

log "invoked" "action=${ACTION} client=${CLIENT%% *} original=$(scrub "$RAW_CMD")"

################################################################################
# status — read-only, no guards needed
################################################################################

if [[ "$ACTION" == "status" ]]; then
    echo "site:        ${SITE} (${DOMAIN})"
    echo "golden dir:  ${GOLDEN_DIR}"
    if [[ -s "${GOLDEN_DIR}/golden.manifest.json" ]]; then
        echo "golden:      captured $(jq -r '.captured_utc // "?"' "${GOLDEN_DIR}/golden.manifest.json" 2>/dev/null)"
    else
        echo "golden:      MISSING"
    fi
    echo "last reset:  $(cat "$STAMP_FILE" 2>/dev/null || echo none)"
    echo "--- last 15 log lines ---"
    tail -n 15 "$LOG_FILE" 2>/dev/null || true
    exit 0
fi

################################################################################
# harvest — DRAIN the spooled error digests to stdout (read-only)
#
# The pre-wipe harvest has always WRITTEN digests here, and nothing ever
# collected them: they aged out of the 30-file window and every error a tester
# ever hit on live was lost silently. That is the pilot's entire point going
# missing, so this is the other half of the loop.
#
# READ-ONLY ON PURPOSE. It emits and deletes nothing, so a failed or half-read
# drain loses nothing and can simply be re-run. Marking files "sent" from here
# would mean this restricted key could destroy evidence, and would put the
# only record of a bad night one crashed pipe away from gone. The consumer
# deduplicates by filename against what it has already posted.
#
# The envelope is a fixed literal so the consumer can split a stream of digests
# without guessing where one ends.
################################################################################

if [[ "$ACTION" == "harvest" ]]; then
    if [[ ! -d "$HARVEST_DIR" ]]; then
        echo "NWP-HARVEST-EMPTY"
        exit 0
    fi
    n=0
    for f in $(ls -1t "${HARVEST_DIR}"/harvest-*.txt 2>/dev/null); do
        [[ -s "$f" ]] || continue
        echo "NWP-HARVEST-BEGIN $(basename "$f")"
        cat "$f"
        echo "NWP-HARVEST-END $(basename "$f")"
        n=$(( n + 1 ))
    done
    [[ "$n" -eq 0 ]] && echo "NWP-HARVEST-EMPTY"
    log "harvest-drained" "files=${n} client=${CLIENT%% *}"
    exit 0
fi

################################################################################
# ops#315 shared helper: the walled api token, or empty. Never printed, never
# logged, never in any argv this wrapper builds for curl.
################################################################################

box_token() {
    "${ROOT_SUDO[@]}" cat "$TOKEN_FILE" 2>/dev/null | tr -d '[:space:]'
}

################################################################################
# feedback-sync — push pending tester Feedback to GitLab BEFORE the wipe
# (ops#315; the box-side twin of lib/demo.sh:demo_feedback_sync, same four
# stages in the same order so the two implementations cannot disagree about
# what may leave: probe → ops#140 interlock → token → push).
#
# nwd-ONLY BY DESIGN: Moodle's local_feedback forwards each report at submit
# time, so the ssd wrapper deliberately does not know this word.
#
# Deliberately LOCKLESS, like `harvest`: the verb sequences it before the
# reset, and a stray overlap costs at worst a failed drush call (exit 1,
# retryable) — never a wrong push and never a blocked reset.
################################################################################

if [[ "$ACTION" == "feedback-sync" ]]; then
    # 1. Is anything pending? --dry-run needs NO token and makes no network
    #    call, so a quiet night on an unprovisioned box is a clean no-op.
    FB_OUT="$( cd "$SITE_ROOT" \
               && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" "$FEEDBACK_SYNC_CMD" \
                    --dry-run --limit=1 2>/dev/null )" || {
        log "feedback-sync-failed" "stage=probe"
        echo "FAIL  could not probe the pending feedback set." >&2
        exit 1
    }
    if [[ "$FB_OUT" == *"$FEEDBACK_NONE_MARKER"* ]]; then
        log "feedback-sync-empty" "nothing pending"
        echo "OK  no tester feedback pending — nothing to sync."
        exit 0
    fi

    # 2. ops#140 INTERLOCK — minimised, or nothing leaves this box. The gate
    #    checks the DEPLOYED module code, which lives here anyway; an
    #    unreadable answer is a refusal, not a pass.
    FB_MIN="$( cd "$SITE_ROOT" \
               && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" php:eval "$FEEDBACK_MIN_PROBE" 2>/dev/null )" || FB_MIN=""
    if [[ "$FB_MIN" != *MINIMISED-OK* ]]; then
        log "feedback-sync-refused" "reason=minimisation-unverified"
        echo "REFUSED  the deployed nwc_feedback does not provably carry the ops#140 minimisation — nothing was sent." >&2
        echo "         Deploy nwc main (MR nwp/nwc!50 or later), then re-run." >&2
        exit 1
    fi

    # 3. Token — read only once there is something minimised to send. Missing
    #    is CANNOT VERIFY: feedback IS pending and this leg could not run.
    FB_TOKEN="$(box_token)"
    if [[ -z "$FB_TOKEN" ]]; then
        log "feedback-sync-no-token" "file=${TOKEN_FILE}"
        cat >&2 <<EOF
CANNOT VERIFY  no api token at ${TOKEN_FILE} — tester feedback IS pending and was NOT pushed.
Provisioning is an OPERATOR step (registry entry demo_box_feedback_token); this wrapper never mints or holds one.
EOF
        exit 2
    fi

    # 4. Push through the module's own command. Same stated exposure as
    #    lib/demo.sh: --token= is argv-visible to ps for the life of the call;
    #    the identity is a walled issue-write bot, it is never printed or
    #    logged here, and anything drush echoes back is redacted below.
    FB_RC=0
    FB_OUT="$( cd "$SITE_ROOT" \
               && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" "$FEEDBACK_SYNC_CMD" \
                    --limit=${FEEDBACK_LIMIT} "--token=${FB_TOKEN}" 2>&1 )" || FB_RC=$?
    FB_OUT="${FB_OUT//"$FB_TOKEN"/<redacted>}"
    FB_TOKEN=""
    if (( FB_RC != 0 )); then
        log "feedback-sync-failed" "stage=push rc=${FB_RC}"
        printf '%s\n' "$FB_OUT"
        exit 1
    fi
    FB_N="$(printf '%s\n' "$FB_OUT" | grep -c '\[OK\] feedback #')" || FB_N=0
    log "feedback-sync-ok" "synced=${FB_N}"
    printf '%s\n' "$FB_OUT"
    echo "OK  feedback-sync complete (synced=${FB_N})."
    exit 0
fi

################################################################################
# harvest-post — post the spooled pre-wipe digests to nwp/ops (ops#315)
#
# The write-side complement of the read-only `harvest` drain: GitLab confirms
# an iid, THEN the digest moves to posted/ — a failed post keeps the file in
# the spool for the next attempt, so a crashed pipe loses nothing (the same
# retry-safe contract as `pl demo harvest-post`). Each posted file is named on
# stdout machine-readably (NWP-HARVEST-POSTED <basename> iid=<iid>) so the
# calling verb can mark its own pulled copy and never double-post.
################################################################################

if [[ "$ACTION" == "harvest-post" ]]; then
    HP_TOKEN="$(box_token)"
    if [[ -z "$HP_TOKEN" ]]; then
        log "harvest-post-no-token" "file=${TOKEN_FILE}"
        cat >&2 <<EOF
CANNOT VERIFY  no api token at ${TOKEN_FILE} — spooled digests were NOT posted and are KEPT in ${HARVEST_DIR}.
Provisioning is an OPERATOR step (registry entry demo_box_feedback_token); this wrapper never mints or holds one.
EOF
        exit 2
    fi
    if [[ ! -d "$HARVEST_DIR" ]]; then
        HP_TOKEN=""
        log "harvest-post-done" "posted=0 failed=0 (no spool)"
        echo "OK  no harvest spool — nothing to post."
        exit 0
    fi
    mkdir -p "${HARVEST_DIR}/posted" 2>/dev/null || true

    # The token travels in a 0600 curl config, never in curl's argv (argv is
    # world-readable via ps; the config file is not).
    HP_CFG="$(umask 077 && mktemp)" || { HP_TOKEN=""; die "harvest-post-failed" "cannot create curl config"; }
    trap 'rm -f "$HP_CFG"' EXIT
    printf 'header = "PRIVATE-TOKEN: %s"\n' "$HP_TOKEN" > "$HP_CFG"
    HP_TOKEN=""

    HP_POSTED=0; HP_FAILED=0
    for HP_F in $(ls -1 "${HARVEST_DIR}"/harvest-*.txt 2>/dev/null | sort); do
        [[ -s "$HP_F" ]] || continue
        HP_BASE="$(basename "$HP_F")"
        HP_WHEN="${HP_BASE#harvest-}"; HP_WHEN="${HP_WHEN%.txt}"
        HP_TITLE="Demo harvest — ${SITE}: errors before the ${HP_WHEN} reset"
        HP_BODY="$(printf 'harvested_utc: %s\n\nPre-wipe error digest posted from the %s live box.\n\n```\n%s\n```\n' \
                        "$HP_WHEN" "$SITE" "$(cat "$HP_F")")"
        HP_PAYLOAD="$(jq -nc --arg t "$HP_TITLE" --arg d "$HP_BODY" --arg l "$HARVEST_LABELS" \
                        '{title:$t, description:$d, labels:$l}')" || {
            log "harvest-post-failed" "file=${HP_BASE} reason=payload"
            HP_FAILED=$(( HP_FAILED + 1 )); continue; }
        HP_RESP="$(curl -sS -K "$HP_CFG" --max-time 30 -H 'Content-Type: application/json' \
                        -d "$HP_PAYLOAD" "${GITLAB_API}/projects/${OPS_PROJECT_ID}/issues" 2>/dev/null)" || HP_RESP=""
        HP_IID="$(printf '%s' "$HP_RESP" | jq -r '.iid // empty' 2>/dev/null)"
        if [[ -n "$HP_IID" ]]; then
            mv "$HP_F" "${HARVEST_DIR}/posted/${HP_BASE}"
            log "harvest-posted" "file=${HP_BASE} issue=#${HP_IID}"
            echo "NWP-HARVEST-POSTED ${HP_BASE} iid=${HP_IID}"
            HP_POSTED=$(( HP_POSTED + 1 ))
        else
            log "harvest-post-failed" "file=${HP_BASE}"
            echo "FAIL  ${HP_BASE} — not posted (kept in the spool for retry)" >&2
            HP_FAILED=$(( HP_FAILED + 1 ))
        fi
    done
    rm -f "$HP_CFG"; trap - EXIT
    # posted/ is bounded like the spool itself (the box is small); the drain's
    # consumer keeps its own copies, so pruning here destroys no last record.
    ls -1t "${HARVEST_DIR}/posted"/harvest-*.txt 2>/dev/null | tail -n +61 | xargs -r rm -f
    log "harvest-post-done" "posted=${HP_POSTED} failed=${HP_FAILED}"
    echo "OK  harvest-post: posted=${HP_POSTED} failed=${HP_FAILED}"
    [[ "$HP_FAILED" -eq 0 ]] || exit 1
    exit 0
fi

################################################################################
# [G6] Single-flight
################################################################################

exec 9>"$LOCK_FILE" 2>/dev/null || true
if ! flock -n 9; then
    log "skip-locked" "another reset is already running"
    echo "Another nwd demo reset is already running — nothing to do."
    exit 0
fi

################################################################################
# Helpers
################################################################################

drush() { ( cd "$SITE_ROOT" && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" "$@" ); }

mel_today() { TZ="$TZ_MEL" date '+%Y-%m-%d'; }

# [G3] Fail-closed golden verification: manifest names THIS site and both
# artifacts match their sha256 sidecars. Identical contract to
# lib/demo.sh:demo_golden_verify, reimplemented here so the box needs no repo.
golden_verify() {
    local manifest="${GOLDEN_DIR}/golden.manifest.json"
    [[ -s "$manifest" ]] || { echo "no golden manifest at $manifest" >&2; return 1; }
    jq -e . "$manifest" >/dev/null 2>&1 || { echo "golden manifest is not valid JSON" >&2; return 1; }
    local msite; msite="$(jq -r '.site // empty' "$manifest")"
    [[ "$msite" == "$SITE" ]] || { echo "golden manifest is for site '$msite', not '$SITE'" >&2; return 1; }
    local f
    for f in "$GOLDEN_DB" "$GOLDEN_FILES"; do
        [[ -f "${GOLDEN_DIR}/${f}" && -f "${GOLDEN_DIR}/${f}.sha256" ]] || {
            echo "golden artifact or sidecar missing: ${GOLDEN_DIR}/${f}" >&2; return 1; }
        ( cd "$GOLDEN_DIR" && sha256sum -c "${f}.sha256" >/dev/null 2>&1 ) || {
            echo "sha256 MISMATCH for ${f} — golden corrupt" >&2; return 1; }
    done
    return 0
}

# [G2] The live site must report demo_mode = true. This is the check that stops
# this script from ever wiping a non-demo site, even if SITE_ROOT were wrong.
require_demo_mode() {
    local val
    val="$(drush cget nwc_demo_access.settings demo_mode --format=string 2>/dev/null | tr -d '[:space:]')"
    case "$val" in
        1|true|TRUE) return 0 ;;
    esac
    echo "site does not report demo_mode=true (got '${val:-<none>}')" >&2
    return 1
}

# [G4] Idle guard. Empty/garbled result → treat as ACTIVE. Never wipe on bad data.
newest_session() {
    drush sqlq 'SELECT COALESCE(MAX(timestamp),0) FROM sessions' 2>/dev/null | tr -d '[:space:]'
}

idle_ok() {
    local newest="$1" now age
    [[ "$newest" =~ ^[0-9]+$ ]] || return 1     # garbled → ACTIVE
    now="$(date +%s)"
    [[ "$newest" -eq 0 ]] && return 0           # no sessions at all → idle
    age=$(( now - newest ))
    [[ "$age" -ge "$IDLE_WINDOW" ]]
}

################################################################################
# Guards (run for dry-run too — a dry run is exactly "all guards, no wipe")
################################################################################

[[ -d "$SITE_ROOT" && -x "${SITE_ROOT}/vendor/bin/drush" ]] \
    || die "precheck-failed" "no drush at ${SITE_ROOT}/vendor/bin/drush"
[[ -d "$FILES_PARENT" ]] || die "precheck-failed" "no files parent at ${FILES_PARENT}"

golden_verify || die "reset-failed" "reason=golden-verify"
echo "OK  golden image verified (manifest site=${SITE} + sha256 x2)"

require_demo_mode || die "reset-failed" "reason=not-demo-mode"
echo "OK  site reports demo_mode=true"

# [G5] Idempotence. `nightly` is a no-op once today's reset has succeeded;
# `reset` overrides the daily stamp but not the minimum interval.
TODAY="$(mel_today)"
LAST_LINE="$(cat "$STAMP_FILE" 2>/dev/null || true)"
LAST_DATE="${LAST_LINE%% *}"
LAST_EPOCH="${LAST_LINE##* }"
[[ "$LAST_EPOCH" =~ ^[0-9]+$ ]] || LAST_EPOCH=0

if [[ "$ACTION" == "nightly" && "$LAST_DATE" == "$TODAY" ]]; then
    log "skip-already-reset" "date=${TODAY}"
    echo "OK  ${SITE} already reset today (${TODAY} ${TZ_MEL}) — nothing to do."
    exit 0
fi

SINCE=$(( $(date +%s) - LAST_EPOCH ))
if [[ "$ACTION" != "dry-run" && "$LAST_EPOCH" -gt 0 && "$SINCE" -lt "$MIN_INTERVAL" ]]; then
    log "skip-rate-limited" "since=${SINCE}s min=${MIN_INTERVAL}s"
    echo "OK  last reset was ${SINCE}s ago (minimum ${MIN_INTERVAL}s) — nothing to do."
    exit 0
fi

NEWEST="$(newest_session)"
if ! idle_ok "$NEWEST"; then
    log "skip-active" "window=${IDLE_WINDOW}s newest=${NEWEST:-query-failed}"
    echo "ACTIVE  session activity within $(( IDLE_WINDOW / 60 )) min (newest=${NEWEST:-query-failed}) — NOT resetting."
    exit 3
fi
echo "OK  idle for >= $(( IDLE_WINDOW / 60 )) min (newest=${NEWEST})"

################################################################################
# [G9] FATE MANIFEST — printed and logged BEFORE anything destructive runs.
#
# Every figure is read live off this box (du, drush, jq, stat). Nothing here is
# assumed: if a size cannot be read the field says "?" rather than a guess, so
# the manifest can never overstate how much is known.
#
# Two different things are deliberately NOT conflated:
#   * DEGRADED — a figure could not be read. The `|| true` / "?" discipline
#     throughout means this never fails; a partial manifest is still a manifest
#     and the reset proceeds.
#   * FAILED — the manifest could not be produced at all, or could not be
#     written to LOG_FILE. Then there is no record, and [G9] says a reset
#     without a record does not happen. The call site below enforces that.
################################################################################

_size_of() {   # human size of a path, or "?" — never fails
    du -sh "$1" 2>/dev/null | awk '{print $1}' || true
}

render_fate_manifest() {
    local db_bytes db_size files_size code_count golden_captured
    db_bytes="$(drush sqlq "SELECT COALESCE(SUM(data_length+index_length),0) FROM information_schema.TABLES WHERE table_schema=DATABASE()" 2>/dev/null | tr -dc '0-9')"
    if [[ -n "$db_bytes" ]]; then
        db_size="$(numfmt --to=iec --suffix=B "$db_bytes" 2>/dev/null || echo "${db_bytes}B")"
    else
        db_size="?"
    fi
    files_size="$(_size_of "${FILES_PARENT}/files")"
    golden_captured="$(jq -r '.captured_utc // "?"' "${GOLDEN_DIR}/golden.manifest.json" 2>/dev/null || echo '?')"
    if [[ -s "$CODES_PAYLOAD" ]]; then
        code_count="$(jq -r '.codes | length' "$CODES_PAYLOAD" 2>/dev/null || echo '?')"
    else
        code_count="not-staged"
    fi

    echo ""
    echo "FATE MANIFEST — ${SITE} (${DOMAIN}) demo reset, action=${ACTION}"
    echo "  source of truth: golden image ${GOLDEN_DIR} (captured ${golden_captured}, sha256 verified)"
    echo ""
    echo "WILL BE PERMANENTLY DELETED:"
    echo "    Uploads:    ${FILES_PARENT}/files (${files_size:-?}) — removed, then replaced from golden."
    echo "                Anything a tester uploaded since the last reset is GONE; there is no copy."
    echo "    Watchdog:   the dblog table — a digest is harvested to ${HARVEST_DIR} first (best effort)."
    echo ""
    echo "WILL BE OVERWRITTEN:"
    echo "    Database:   ${SITE} (${db_size}) — dropped and reloaded from ${GOLDEN_DB}."
    echo "                All demo accounts, content and sessions revert to the golden state."
    echo "    Demo users: reseeded by 'drush nwc:seed-demo'."
    echo "    Invite codes: staged payload holds ${code_count} code(s) — the staged payload is"
    echo "                AUTHORITATIVE and replaces whatever the site currently has."
    echo ""
    echo "NOT AFFECTED:"
    echo "    • the golden image itself (read-only here; a failed restore leaves it intact)"
    echo "    • every other site on this box — SITE_ROOT is hard-wired to ${SITE_ROOT} [G2]"
    echo "      and the live site was re-checked to report demo_mode=true"
    echo "    • plaintext invite codes — only hashes ever exist on this box"
    echo "    • ${LOG_FILE} and the harvest digests"
    echo ""

    # Last statement on purpose: "printed AND logged" means this function is
    # only successful if the line actually landed in LOG_FILE.
    log "fate-manifest" "action=${ACTION} db=${db_size} files=${files_size:-?} codes=${code_count} golden=${golden_captured}" \
        || return 1
}

# [G9] enforcement. The manifest is the licence to destroy, so a real reset that
# has not got one stops here rather than proceeding to wipe with the failure
# merely noted. A dry-run keeps the old fail-open behaviour: nothing destructive
# follows it, so aborting would remove an operator's only way to look without
# protecting anything.
if ! render_fate_manifest; then
    if [[ "$ACTION" == "dry-run" ]]; then
        log "fate-manifest-failed" "dry-run — nothing destructive follows, continuing"
    else
        die "fate-manifest-failed" \
            "refusing to destroy anything without a printed+logged manifest [G9]" 1
    fi
fi

if [[ "$ACTION" == "dry-run" ]]; then
    log "dry-run-ok" "all guards passed; nothing changed"
    echo "OK  DRY RUN — all guards passed and the manifest above is what a real run would do."
    echo "OK  Nothing was changed."
    exit 0
fi

################################################################################
# Destructive section
################################################################################

START="$(date +%s)"

# Pre-wipe error harvest (fail-OPEN — must never block the reset). The restore
# destroys watchdog, so the digest has to be taken first.
harvest() {
    mkdir -p "$HARVEST_DIR" 2>/dev/null || return 0
    local out="${HARVEST_DIR}/harvest-$(date -u '+%Y%m%d-%H%M%S').txt"
    {
        drush watchdog:show --severity=Error    --count=100 --format=table 2>/dev/null
        drush watchdog:show --severity=Critical --count=100 --format=table 2>/dev/null
    } > "$out" 2>/dev/null || true
    if [[ -s "$out" ]]; then
        log "harvest" "file=$(basename "$out") bytes=$(stat -c%s "$out" 2>/dev/null || echo 0)"
    else
        rm -f "$out" 2>/dev/null || true
    fi
    # Keep the last 30 digests; the box is small.
    ls -1t "${HARVEST_DIR}"/harvest-*.txt 2>/dev/null | tail -n +31 | xargs -r rm -f
    return 0
}
harvest || true

# Pre-wipe TESTER-FEEDBACK notice (fail-OPEN — nwp/ops#161, closable ops#315).
#
# The harvest above keeps the errors nobody reported. The reports testers DID
# file are Feedback entities in the database the next block replaces. The
# `feedback-sync` action word above is the leg that pushes them — `pl demo
# nightly --via-key` invokes it BEFORE the reset — but this reset path does
# not assume that happened: a raw-ssh cron, a hand-run `reset`, or a
# feedback-sync that could not run (no token yet: exit 2 CANNOT VERIFY) all
# arrive here with the pending set intact.
#
# So the one honest thing this path does is refuse to destroy them SILENTLY.
# It counts what is about to go, logs it, and names the words that recover it.
# The count is a read-only --dry-run of the module's own sync command: no
# token, no network call, and any failure is swallowed.
#
# (Until ops#315 this was a KNOWN GAP — the wrapper held no token at all. The
# gap now closes the moment the operator stages TOKEN_FILE; this notice stays
# because a fail-open pre-leg can always have failed.)
feedback_pending() {
    local out
    out="$( cd "$SITE_ROOT" \
            && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" nwc-feedback:sync-to-gitlab \
                 --dry-run --limit=100 2>/dev/null )" || return 0
    [[ -n "$out" ]] || return 0
    case "$out" in
        *"No feedback items pending GitLab sync"*)
            log "feedback-none-pending" "nothing to lose"
            return 0 ;;
    esac
    local n
    n="$(printf '%s\n' "$out" | grep -c '\[DRY\] feedback #' 2>/dev/null)" || n="?"
    log "feedback-pending-unsynced" "count=${n} (DESTROYED by this reset — the feedback-sync leg did not run)"
    echo "WARN  ${n} tester feedback report(s) are pending GitLab sync and this reset DESTROYS them."
    echo "WARN  The pre-wipe leg did not run (or could not). Recover before the next reset with either:"
    echo "WARN      ssh -i ~/.ssh/${SITE}_demo_reset gitlab@<box> feedback-sync   (the box's own word)"
    echo "WARN      pl demo feedback-sync ${SITE} --tier=live                     (from an admin host)"
    return 0
}
feedback_pending || true

echo "..  restoring database from golden"
if ! ( cd "$SITE_ROOT" \
        && "${DRUSH_SUDO[@]}" "$DRUSH_BIN" sql:drop -y >/dev/null 2>&1 \
        && gunzip -c "${GOLDEN_DIR}/${GOLDEN_DB}" | "${DRUSH_SUDO[@]}" "$DRUSH_BIN" sql:cli ); then
    die "reset-failed" "reason=import-db (golden intact at ${GOLDEN_DIR} — restore by hand)"
fi

echo "..  restoring files from golden"
if ! ( "${ROOT_SUDO[@]}" rm -rf "${FILES_PARENT}/files" \
        && "${ROOT_SUDO[@]}" tar xzf "${GOLDEN_DIR}/${GOLDEN_FILES}" -C "$FILES_PARENT" \
        && "${ROOT_SUDO[@]}" chown -R www-data:www-data "${FILES_PARENT}/files" ); then
    die "reset-failed" "reason=files-untar"
fi

echo "..  reseeding demo accounts (drush nwc:seed-demo)"
if ! drush nwc:seed-demo >/dev/null 2>&1; then
    die "reset-failed" "reason=seed-demo"
fi

# Re-push the hashed invite-code registry, if one has been staged. Hashes only
# — the plaintext codes never exist on this box. Non-fatal: without it the
# codes simply revert to whatever the golden snapshot held.
if [[ -s "$CODES_PAYLOAD" ]]; then
    CODE_COUNT="$(jq -r '.codes | length' "$CODES_PAYLOAD" 2>/dev/null || echo '?')"
    if drush state:set nwc_demo_access.codes "$(cat "$CODES_PAYLOAD")" >/dev/null 2>&1; then
        log "codes-synced" "count=${CODE_COUNT} staged=$(date -u -r "$CODES_PAYLOAD" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo '?')"
        # The staged payload is authoritative — same contract as the laptop's
        # `pl demo reset --tier=live`. An empty payload therefore CLEARS every
        # invite code, so it must be re-staged after any `pl demo codes|invite`
        # (install-box.sh --stage-codes). Loud, because it locks testers out.
        [[ "$CODE_COUNT" == "0" ]] && echo "WARN  staged code payload is EMPTY — all invite codes are now cleared. Re-stage with install-box.sh --stage-codes."
    else
        log "codes-sync-failed" "non-fatal"
    fi
else
    log "codes-not-staged" "codes revert to the golden snapshot"
fi

drush cr >/dev/null 2>&1 || log "cr-failed" "non-fatal"

# Declared BEFORE the first thing that can set it: [G10] below and the smoke
# check both degrade the run, and re-initialising it between them would erase
# whichever spoke first.
DEGRADED=false

# [G10] Post-restore pending-update detection (ops#226). A golden captured
# while an update was pending restores a permanently-pending site: the schema
# comes back pre-update every night and nothing here runs updatedb. Capture now
# refuses that, but older goldens predate the guard, so a reset that puts one
# back must SAY so rather than report reset-ok.
#
# Fail-closed on the read, not on the site: a probe we cannot read is degraded,
# not fatal — the data is already restored and the operator needs the report.
# Clean sites print nothing on stdout, hence the marker.
PENDING_JSON="$(drush updatedb:status --format=json 2>/dev/null && echo "$PENDING_MARKER")"
if ! printf '%s\n' "$PENDING_JSON" | grep -qx "$PENDING_MARKER"; then
    DEGRADED=true
    log "reset-pending-updates" "state=unreadable"
    echo "FAIL  could not read the site's update state after the restore — treat the golden as unverified."
else
    PENDING_PAYLOAD="$(printf '%s\n' "$PENDING_JSON" | grep -vx "$PENDING_MARKER" | sed '/^[[:space:]]*$/d')"
    if [[ -n "$PENDING_PAYLOAD" ]]; then
        PENDING_N="$(printf '%s' "$PENDING_PAYLOAD" | jq -r 'length' 2>/dev/null || echo '?')"
        if [[ "$PENDING_N" != "0" ]]; then
            DEGRADED=true
            log "reset-pending-updates" "pending=${PENDING_N} golden_attests=$(jq -r '.pending_db_updates // "unknown"' "${GOLDEN_DIR}/golden.manifest.json" 2>/dev/null || echo unknown)"
            echo "FAIL  ${PENDING_N} database update(s) are PENDING after the restore."
            printf '%s' "$PENDING_PAYLOAD" | jq -r 'if type=="object" then keys_unsorted[] else (.[]|tostring) end' 2>/dev/null | head -10 | sed 's/^/      /'
            echo "      The golden itself carries them, so running updatedb here is undone at the next reset."
            echo "      Fix: run the updates, then re-capture the golden (pl demo golden nwd --tier=live)."
        fi
    fi
fi

# Post-restore smoke, retried: the first request after a cache rebuild is a
# cold full render and on this small shared host that can 5xx once before the
# caches warm. Persistent failure is real and degrades the exit status.
CODE=""
for _ in $(seq 1 "$SMOKE_ATTEMPTS"); do
    CODE="$(curl -s -o /dev/null -w '%{http_code}' --max-time 45 "https://${DOMAIN}/" 2>/dev/null || echo 000)"
    [[ "$CODE" == "200" ]] && break
    sleep "$SMOKE_SLEEP"
done
if [[ "$CODE" == "200" ]]; then
    JCODE="$(curl -s -o /dev/null -w '%{http_code}' --max-time 45 "https://${DOMAIN}/demo/join" 2>/dev/null || echo 000)"
    if [[ "$JCODE" == "200" ]]; then
        echo "OK  https://${DOMAIN}/ and /demo/join both serve 200"
    else
        DEGRADED=true
        log "reset-degraded" "join_http=${JCODE}"
        echo "FAIL  /demo/join returned ${JCODE} — testers cannot join."
    fi
else
    DEGRADED=true
    log "reset-degraded" "http=${CODE} attempts=${SMOKE_ATTEMPTS}"
    echo "FAIL  https://${DOMAIN}/ still ${CODE} after ${SMOKE_ATTEMPTS} attempts."
fi

TOOK=$(( $(date +%s) - START ))

if [[ "$DEGRADED" == "true" ]]; then
    log "reset-ok-degraded" "took=${TOOK}s"
    echo "WARN  data restored but the site failed its smoke check — treat as FAILED."
    exit 1
fi

# Stamp only a fully clean reset [G5].
mkdir -p "$STATE_DIR" 2>/dev/null || true
printf '%s %s\n' "$TODAY" "$(date +%s)" > "$STAMP_FILE"
log "reset-ok" "took=${TOOK}s action=${ACTION}"
echo "OK  nwd demo reset complete in ${TOOK}s — back at the golden image."
exit 0
