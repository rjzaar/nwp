+     data-episode="{{episode}}"
+     data-current-start="{{current_start_s}}"
+     data-current-end="{{current_end_s}}"
+     data-youtube-id="{{youtube_id}}">
+
+  <div class="dc-fb-cd-tabs" role="tablist">
+    <button type="button" data-cd-tab="c" class="active" aria-selected="true">{{#str}}feedback_level_c_tab, mod_depthcontent{{/str}}</button>
+    <button type="button" data-cd-tab="d" aria-selected="false">{{#str}}feedback_level_d_tab, mod_depthcontent{{/str}}</button>
+  </div>
+
+  <section class="dc-fb-cd-pane dc-fb-cd-c" data-cd-pane="c">
+    <p class="muted">{{#str}}feedback_level_c_intro, mod_depthcontent{{/str}}</p>
+    <label>{{#str}}feedback_level_c_slot_fit, mod_depthcontent{{/str}}
+      <input type="range" min="0" max="10" step="1" name="slot_fit" value="7">
+      <output name="slot_fit_value">7</output>
+    </label>
+    <label>
+      <input type="checkbox" name="authority_ok" checked>
+      {{#str}}feedback_level_c_authority_ok, mod_depthcontent{{/str}}
+    </label>
+    <label>{{#str}}feedback_level_c_cross_ref, mod_depthcontent{{/str}}
+      <input type="text" name="cross_ref" placeholder="e.g. LG §40">
+    </label>
+    <label>{{#str}}feedback_level_c_notes, mod_depthcontent{{/str}}
+      <textarea name="notes" rows="3"></textarea>
+    </label>
+    <button type="button" data-cd-submit="c">{{#str}}feedback_level_c_submit, mod_depthcontent{{/str}}</button>
+  </section>
+
+  <section class="dc-fb-cd-pane dc-fb-cd-d" data-cd-pane="d" hidden>
+    <p class="muted">{{#str}}feedback_level_d_intro, mod_depthcontent{{/str}}</p>
+    <fieldset class="dc-fb-cd-trim">
+      <legend>{{#str}}feedback_level_d_trim, mod_depthcontent{{/str}}</legend>
+      <label>{{#str}}feedback_level_d_start, mod_depthcontent{{/str}}
+        <input type="number" name="start_s" min="0" step="0.5" value="{{current_start_s}}">
+      </label>
+      <label>{{#str}}feedback_level_d_end, mod_depthcontent{{/str}}
+        <input type="number" name="end_s" min="0" step="0.5" value="{{current_end_s}}">
+      </label>
+      <p class="trim-hint">{{#str}}feedback_level_d_trim_hint, mod_depthcontent{{/str}}</p>
+    </fieldset>
+    <label>{{#str}}feedback_level_d_rationale, mod_depthcontent{{/str}}
