# /etc/nwp-server/<site>.env — per-site config for nwp-server-backup@<site>.service
# Install as 0600 (may hold a repo path, not secrets — the restic password lives
# in a separate --pass-file, default /etc/nwp-server/restic.pass).
#
#   install -m600 nwp-server-backup.env.example /etc/nwp-server/ss.env

# REQUIRED — deployed site root (Moodle root, or Drupal project dir):
SITE_DIR=/var/www/ss

# REQUIRED — minisign public key used to verify the restic binary before use
# (supply-chain gate; server-backup is fail-closed without it):
RESTIC_PUB=/etc/nwp-server/restic.pub

# OPTIONAL — extra args passed verbatim to `nwp-server backup`. Examples:
#   --repo /var/backups/nwp-server/ss   (default is /var/backups/nwp-server/<site>)
#   --pass-file /etc/nwp-server/restic.pass   (this is already the default)
#   --files html/sites/default/files    (Drupal sites with a non-web docroot)
#   --keep-last 3
# Moodle sites need NO --files (moodledata is auto-resolved).
BACKUP_EXTRA_ARGS=

# OPTIONAL — override if nwp-server is not on PATH for systemd:
# NWP_BIN=/opt/nwp/bin/nwp-server
