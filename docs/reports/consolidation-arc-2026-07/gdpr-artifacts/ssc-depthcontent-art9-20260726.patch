+      <INDEXES>
+        <INDEX NAME="user_quiz" UNIQUE="false" FIELDS="userid,depthcontentid,quizitemid"/>
+      </INDEXES>
+    </TABLE>
+
+    <!-- Spaced repetition state -->
+    <TABLE NAME="depthcontent_sr" COMMENT="SM-2 spaced repetition state per user per point">
+      <FIELDS>
+        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
+        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
+        <FIELD NAME="depthcontentid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
+        <FIELD NAME="ease_factor" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" DEFAULT="2.50" SEQUENCE="false"/>
+        <FIELD NAME="interval_days" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
+        <FIELD NAME="repetitions" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="next_review" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
+               COMMENT="Unix timestamp of next scheduled review"/>
+        <FIELD NAME="last_reviewed" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+      </FIELDS>
+      <KEYS>
+        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
+        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
+        <KEY NAME="fk_depthcontent" TYPE="foreign" FIELDS="depthcontentid" REFTABLE="depthcontent" REFFIELDS="id"/>
+      </KEYS>
+      <INDEXES>
+        <INDEX NAME="user_point" UNIQUE="true" FIELDS="userid,depthcontentid"/>
+        <INDEX NAME="next_review" UNIQUE="false" FIELDS="userid,next_review"/>
+      </INDEXES>
+    </TABLE>
+
+    <!-- S13: Feedback state per (course, pointid, depth, slot) -->
+    <TABLE NAME="depthcontent_fb_state" COMMENT="Feedback lock-in state per content slot (S13)">
+      <FIELDS>
+        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
+        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="pointid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"
+               COMMENT="Learning point ID e.g. A1.01"/>
+        <FIELD NAME="depth" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"
+               COMMENT="Depth level e.g. standard, longer, detailed"/>
+        <FIELD NAME="slot" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"
+               COMMENT="Pedagogical slot e.g. definition, illustration"/>
+        <FIELD NAME="status" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="open" SEQUENCE="false"
+               COMMENT="locked|candidates|open"/>
+        <FIELD NAME="current_clip_json" TYPE="text" NOTNULL="false" SEQUENCE="false"
+               COMMENT="JSON: current clip (episode, start_s, end_s, video_url, title)"/>
+        <FIELD NAME="candidates_json" TYPE="text" NOTNULL="false" SEQUENCE="false"
+               COMMENT="JSON: array of alternative candidates when status=candidates"/>
+        <FIELD NAME="locked_by" TYPE="char" LENGTH="128" NOTNULL="false" SEQUENCE="false"
+               COMMENT="Who/what locked the slot (auto_level_a, user_id, null)"/>
+        <FIELD NAME="locked_at" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="updated_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+      </FIELDS>
+      <KEYS>
+        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
+      </KEYS>
+      <INDEXES>
+        <INDEX NAME="slot_unique" UNIQUE="true" FIELDS="courseid,pointid,depth,slot"/>
+        <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
+      </INDEXES>
+    </TABLE>
+
+    <!-- S13: Append-only feedback event log -->
+    <TABLE NAME="depthcontent_fb_events" COMMENT="Append-only log of feedback submissions (S13)">
+      <FIELDS>
+        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
+        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="fb_state_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="level" TYPE="char" LENGTH="2" NOTNULL="true" SEQUENCE="false"
+               COMMENT="a|b|c|d"/>
+        <FIELD NAME="payload_json" TYPE="text" NOTNULL="false" SEQUENCE="false"
+               COMMENT="JSON payload of the feedback submission"/>
+        <FIELD NAME="created_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+      </FIELDS>
+      <KEYS>
+        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
+        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
+        <KEY NAME="fk_fb_state" TYPE="foreign" FIELDS="fb_state_id" REFTABLE="depthcontent_fb_state" REFFIELDS="id"/>
+      </KEYS>
+      <INDEXES>
+        <INDEX NAME="state_level" UNIQUE="false" FIELDS="fb_state_id,level"/>
+        <INDEX NAME="user_state" UNIQUE="false" FIELDS="userid,fb_state_id"/>
+      </INDEXES>
+    </TABLE>
+
+    <!-- S13: Vote tallies per fb_state_id, vote_key -->
+    <TABLE NAME="depthcontent_fb_votes" COMMENT="Aggregated vote tallies per feedback slot (S13)">
+      <FIELDS>
+        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
+        <FIELD NAME="fb_state_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="vote_key" TYPE="char" LENGTH="128" NOTNULL="true" SEQUENCE="false"
+               COMMENT="Candidate id, thumbs_up, thumbs_down, verdict_yes, etc."/>
+        <FIELD NAME="count" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="updated_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+      </FIELDS>
+      <KEYS>
+        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
+        <KEY NAME="fk_fb_state" TYPE="foreign" FIELDS="fb_state_id" REFTABLE="depthcontent_fb_state" REFFIELDS="id"/>
+      </KEYS>
+      <INDEXES>
+        <INDEX NAME="state_votekey" UNIQUE="true" FIELDS="fb_state_id,vote_key"/>
+      </INDEXES>
+    </TABLE>
+
+    <!-- ============================================================= -->
+    <!-- Phase 6: Mastery ledger (ACT/HABIT/CHARACTER state machine).   -->
+    <!--                                                                 -->
+    <!-- GDPR (NWC-LEDGER-GDPR-DESIGN-2026-07-20, Art. 9 special         -->
+    <!-- category): these tables record which Catholic doctrines a named -->
+    <!-- member holds/misses. They therefore carry NO foreign keys and   -->
+    <!-- NO delete callbacks, so a data-subject erasure is a trivial     -->
+    <!-- explicit DELETE WHERE userid=? (see lib.php note). Erasure is    -->
+    <!-- performed by a core_privacy provider + the ops#93 round-trip,    -->
+    <!-- NOT by Moodle cascade and NOT by a `clear` render rebuild        -->
+    <!-- (which deliberately preserves member state). No per-(user,       -->
+    <!-- pointid) confidence/"confidently-wrong" flag is persisted:       -->
+    <!-- confidence is transient (retrieval_log only, retention-pruned).  -->
+    <!-- ============================================================= -->
+
+    <!-- Per-(member, LP) mastery ledger. Supersedes depthcontent_sr. -->
+    <TABLE NAME="depthcontent_mastery" COMMENT="Per-(userid, pointid) mastery state; UNIQUE(userid,pointid). No FKs (GDPR erasure = explicit DELETE). pointid is the PERMANENT catalog LP id (e.g. B5.03), never a Moodle instance id.">
+      <FIELDS>
+        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
+        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
+        <FIELD NAME="pointid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"
+               COMMENT="Permanent canonical N4 node id (e.g. B5.03); course-agnostic, NOT the Moodle instance id"/>
+        <!-- Scheduler (v1 SM-2 + lapse count; v2 FSRS columns nullable until fitted). -->
+        <FIELD NAME="ease_factor" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" DEFAULT="2.50" SEQUENCE="false"/>
+        <FIELD NAME="interval_days" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
+        <FIELD NAME="repetitions" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="lapses" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="stability_days" TYPE="number" LENGTH="8" DECIMALS="2" NOTNULL="false" SEQUENCE="false"
+               COMMENT="FSRS S (v2; null until fitted)"/>
+        <FIELD NAME="difficulty_fsrs" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false"
+               COMMENT="FSRS D (v2; null until fitted)"/>
+        <FIELD NAME="next_review" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
+               COMMENT="Unix; daily/weekly SR due queue"/>
+        <FIELD NAME="next_probe" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"
+               COMMENT="Unix; monthly CHARACTER probe queue"/>
+        <FIELD NAME="last_reviewed" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <!-- Attainment (monotonic; 0 = not attained; *_at never cleared by a lapse). -->
+        <FIELD NAME="act_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
+               COMMENT="First verified closed-book correct; IMMUTABLE once confirmed"/>
+        <FIELD NAME="act_via" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false"
+               COMMENT="inline|examination|weekly|book_study"/>
+        <FIELD NAME="act_confirmed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
+               COMMENT="MF-B anti-guess: 1 once confirmed (non-guess/shortanswer/streak>=2); only confirmed ACT gates completion"/>
+        <FIELD NAME="habit_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="habit_streak" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
+               COMMENT="Current spaced-success streak; resets on a miss"/>
+        <FIELD NAME="first_success_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
+               COMMENT="Timestamp of first counted success in current streak (MF-A span floor)"/>
+        <FIELD NAME="last_success_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
+               COMMENT="Timestamp of last counted success (spacing gate)"/>
+        <FIELD NAME="character_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="char_window_start" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="probes_answered" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="distinct_items_correct" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+        <FIELD NAME="last_transfer_ok" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
+               COMMENT="An apply/discern (transfer) item passed in current window"/>
+        <!-- Live state. -->
+        <FIELD NAME="status" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="none" SEQUENCE="false"
+               COMMENT="none|act|habit|character"/>
+        <FIELD NAME="lapsed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
+               COMMENT="Live disposition flag; never clears *_at"/>
+        <FIELD NAME="recent_item_ids" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"
+               COMMENT="Ring buffer of recently served item ids (avoid re-serving)"/>
+        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
+      </FIELDS>
+      <KEYS>
+        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
+        <!-- Deliberately NO foreign keys (GDPR: erasure is an explicit DELETE, no cascade). -->
+      </KEYS>
+      <INDEXES>
+        <INDEX NAME="user_point" UNIQUE="true" FIELDS="userid,pointid"/>
+        <INDEX NAME="next_review" UNIQUE="false" FIELDS="userid,next_review"/>
+        <INDEX NAME="next_probe" UNIQUE="false" FIELDS="userid,next_probe"/>
+      </INDEXES>
+    </TABLE>
+
+    <!-- Append-only retrieval log = FSRS training set + evaluator input. -->
+    <TABLE NAME="depthcontent_retrieval_log" COMMENT="Append-only per-retrieval log keyed on permanent pointid. No FKs (GDPR erasure = explicit DELETE). confidence/latency are transient signals retention-pruned by a later aggregation job.">
+      <FIELDS>
+        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
+        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
+        <FIELD NAME="pointid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"
+               COMMENT="Permanent canonical N4 node id resolved from the item's tags"/>
+        <FIELD NAME="ts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
+               COMMENT="Unix timestamp of the retrieval event"/>
+        <FIELD NAME="outcome" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
+               COMMENT="1 correct, 0 miss"/>
+        <FIELD NAME="grade" TYPE="int" LENGTH="2" NOTNULL="false" SEQUENCE="false"
+               COMMENT="SM-2 grade 1-5 from outcome/confidence/latency mapping"/>
+        <FIELD NAME="item_id" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"
+               COMMENT="Quiz item id e.g. B5.03.q4 (distinct-item + ring-buffer logic)"/>
+        <FIELD NAME="item_type" TYPE="char" LENGTH="16" NOTNULL="false" SEQUENCE="false"
+               COMMENT="multichoice|truefalse|shortanswer"/>
+        <FIELD NAME="cognition" TYPE="char" LENGTH="16" NOTNULL="false" SEQUENCE="false"
+               COMMENT="recall|apply|discern (character transfer requirement)"/>
+        <FIELD NAME="core_accountable" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"
+               COMMENT="MF-4 firewall: only 1 may move the ledger"/>
+        <FIELD NAME="single_tag" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"
+               COMMENT="MF-D: 1 iff the item tags exactly one pointid; only single_tag items advance the HABIT streak"/>
+        <FIELD NAME="confidence" TYPE="int" LENGTH="1" NOTNULL="false" SEQUENCE="false"
+               COMMENT="TRANSIENT 1-tap 1..3 (guessing|think-so|sure); anti-guess + queue priority only; retention-pruned. NOT a per-doctrine stored flag."/>
+        <FIELD NAME="latency_ms" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
+        <FIELD NAME="mode" TYPE="char" LENGTH="16" NOTNULL="false" SEQUENCE="false"
+               COMMENT="inline|examination|weekly|monthly_probe"/>
+        <FIELD NAME="context" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false"
+               COMMENT="Provenance ONLY, never part of the key (e.g. course:B5|book_study:BS-ITD)"/>
+      </FIELDS>
+      <KEYS>
+        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
+        <!-- Deliberately NO foreign keys (GDPR: erasure is an explicit DELETE, no cascade). -->
+      </KEYS>
+      <INDEXES>
+        <INDEX NAME="user_point_ts" UNIQUE="false" FIELDS="userid,pointid,ts"/>
+        <INDEX NAME="user_ts" UNIQUE="false" FIELDS="userid,ts"/>
+      </INDEXES>
+    </TABLE>
+
+  </TABLES>
+</XMLDB>
