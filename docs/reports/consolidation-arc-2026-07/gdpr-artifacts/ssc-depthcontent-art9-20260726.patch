+    Forwards to AVC's clip-review signal endpoint via the external service.
+
+    Example context (json):
+    {
+      "fb_state_id": 42,
+      "episode": 645,
+      "current_start_s": 416,
+      "current_end_s": 535,
+      "youtube_id": "lrgODcWOjnQ"
+    }
+}}
+<div class="depthcontent-feedback-level-cd"
