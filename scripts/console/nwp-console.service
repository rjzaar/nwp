# NWP Console — systemd USER unit (deploy host: mini; linger must be enabled).
# Installed to ~/.config/systemd/user/nwp-console.service by `pl console deploy`.
# All knobs live in ~/.config/nwp-console/env (EnvironmentFile).
[Unit]
Description=NWP Console (mesh-only operational web console)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/nwp-console/env
WorkingDirectory=%h/nwp-console/src
# TLS is mandatory in practice: WebAuthn only works in a secure context.
ExecStart=/bin/bash -c 'exec %h/nwp-console/venv/bin/uvicorn app.main:app \
  --host "${NWP_CONSOLE_BIND}" --port "${NWP_CONSOLE_PORT}" \
  --ssl-certfile "${NWP_CONSOLE_TLS_CERT}" --ssl-keyfile "${NWP_CONSOLE_TLS_KEY}" \
  --workers 1 --no-server-header'
Restart=on-failure
RestartSec=5
# Keep the footprint contained (the host's RAM is shared with local LLMs). The web
# process itself sits ~140 MB; the headroom is for the SHORT-LIVED voice
# children in this cgroup — faster-whisper `base` peaks ~400 MB and piper
# ~180 MB, then exit and give it straight back. 512M would OOM-kill the
# console mid-transcription; drop this back to 512M if you set
# NWP_CONSOLE_STT_BACKEND=off and NWP_CONSOLE_TTS_BACKEND=off.
MemoryMax=1500M
NoNewPrivileges=true
StandardOutput=append:%h/nwp-console/console.log
StandardError=append:%h/nwp-console/console.log

[Install]
WantedBy=default.target
