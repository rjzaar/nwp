#!/bin/bash
# Pipe email from Postfix to AVC email reply webhook
# Called by Postfix transport for reply+*@<prod-base>

WEBHOOK_URL="https://avc.<prod-base>/api/email/inbound"
WEBHOOK_SECRET=<secret-redacted-at-capture>
LOG="/var/log/avc-email-reply.log"

# Read the full email from stdin
EMAIL_BODY="$(cat)"

# Extract headers (handle multiline folding by taking first occurrence)
FROM="$(echo "$EMAIL_BODY" | grep -m1 -i '^From:' | sed 's/^[Ff]rom: *//')"
TO="$(echo "$EMAIL_BODY" | grep -m1 -i '^To:' | sed 's/^[Tt]o: *//')"
SUBJECT="$(echo "$EMAIL_BODY" | grep -m1 -i '^Subject:' | sed 's/^[Ss]ubject: *//')"

# Extract body (everything after first blank line)
TEXT="$(echo "$EMAIL_BODY" | sed -n '/^$/,$p' | tail -n +2)"

# Extract SPF result
SPF="$(echo "$EMAIL_BODY" | grep -m1 -i '^Received-SPF:' | awk '{print $2}')"

# POST to webhook - resolve via loopback so getClientIp() returns 127.0.0.1
HTTP_CODE=$(curl -s -X POST "$WEBHOOK_URL" \
  --resolve "avc.<prod-base>:443:127.0.0.1" \
  --data-urlencode "from=$FROM" \
  --data-urlencode "to=$TO" \
  --data-urlencode "subject=$SUBJECT" \
  --data-urlencode "text=$TEXT" \
  --data-urlencode "SPF=${SPF:-none}" \
  --data-urlencode "spam_score=0" \
  -H "X-Webhook-Secret: $WEBHOOK_SECRET" \
  -o /dev/null -w "%{http_code}" 2>>"$LOG")

echo "$(date +'%Y-%m-%d %H:%M:%S'): from=$FROM to=$TO http=$HTTP_CODE" >> "$LOG"
